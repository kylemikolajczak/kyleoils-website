---
import { getLanguagePaths, type Locale } from '../../data/locales';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const paths = getLanguagePaths(currentPath);
const label = locale === 'de' ? 'Sprache wechseln' : 'Switch language';
---

<nav class="language-switcher" aria-label={label}>
  {locale === 'de' ? <strong aria-current="page">DE</strong> : paths ? <a href={paths.de} hreflang="de" lang="de">DE</a> : <span class="language-switcher__unavailable">DE</span>}
  <span aria-hidden="true">|</span>
  {locale === 'en' ? <strong aria-current="page">EN</strong> : paths ? <a href={paths.en} hreflang="en" lang="en">EN</a> : <span class="language-switcher__unavailable" lang="en">EN</span>}
</nav>

<style>
  .language-switcher { display: inline-flex; align-items: center; gap: var(--space-8); color: var(--color-text-secondary); font-size: var(--font-size-small); line-height: 1; white-space: nowrap; }
  a, strong { min-width: 28px; padding: var(--space-8) var(--space-4); color: inherit; text-align: center; text-decoration: none; }
  strong { color: var(--color-deep-forest); font-weight: var(--font-weight-semibold); }
  .language-switcher__unavailable { color: var(--color-text-muted); opacity: .7; }
  a:hover { color: var(--color-deep-forest); }
  a:focus-visible { border-radius: var(--radius-button); outline: 2px solid var(--color-sage-green); outline-offset: 2px; }

  /* Compact, accessible locale selection; available URLs and hreflang untouched. */
  .language-switcher {
    gap:1px;
    padding:3px;
    color:#667a68;
    border:1px solid rgba(121,147,118,.24);
    background:rgba(235,240,230,.64);
    border-radius:11px;
    line-height:1;
    font-size:11.5px;
    font-weight:650;
  }
  .language-switcher > span[aria-hidden="true"] {display:none;}
  .language-switcher a,.language-switcher strong {
    min-width:33px;
    min-height:31px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:4px 7px;
    border-radius:7px;
    transition:color .2s ease, background .2s ease;
  }
  .language-switcher strong {
    color:#263d32;
    background:#faf7f1;
    box-shadow:0 1px 5px rgba(44,68,51,.11);
    font-weight:750;
  }
  .language-switcher a:hover {background:#e1ebdd;color:#284c38;}
  .language-switcher__unavailable {padding:7px;}
  @media(prefers-reduced-motion:reduce){.language-switcher a{transition:none;}}

</style>
