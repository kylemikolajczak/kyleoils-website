---
import { groupedEnglishMainNavigation, groupedMainNavigation } from '../../data/navigation';
import { contactLinks } from '../../data/externalLinks';
import type { Locale } from '../../data/locales';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale?: Locale;
  currentPath: string;
}

const { locale = 'de', currentPath } = Astro.props;
const navigation = locale === 'de' ? groupedMainNavigation : groupedEnglishMainNavigation;
const menuLabel = locale === 'de' ? 'Menü' : 'Menu';
const navigationLabel = locale === 'de' ? 'Mobile Navigation' : 'Mobile navigation';
const consultationHref = locale === 'de' ? '/de/kontakt/' : '/en/contact/';
const consultationLabel = locale === 'de' ? 'Beratung anfragen' : 'Request a Consultation';
const whatsappLabel = locale === 'de' ? 'WhatsApp starten' : 'Message Me on WhatsApp';
const homeHref = locale === 'de' ? '/de/' : '/en/';
const brandLabel = locale === 'de' ? 'Zur Startseite von Kyle Oils' : 'Go to the Kyle Oils homepage';
const closeLabel = locale === 'de' ? 'Menü schließen' : 'Close menu';
const normalizedPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const isCurrentPage = (href: string) => href === homeHref
  ? normalizedPath === href
  : normalizedPath === href || normalizedPath.startsWith(href);
const isCurrentGroup = (items: readonly { href: string }[]) => items.some((item) => isCurrentPage(item.href));
---

<details class="mobile-menu">
  <summary>{menuLabel}</summary>
  <nav aria-label={navigationLabel}>
    <div class="menu-sheet__top">
      <a class="menu-brand" href={homeHref} aria-label={brandLabel}>
        <img src="/assets/images/optimized/kyle-oils-mark-128.png" alt="" width="56" height="56" />
      </a>
      <button class="menu-close" type="button" aria-label={closeLabel}>×</button>
    </div>
    <ul>
      {navigation.map((item) => 'items' in item ? (
        <li class={`menu-group${isCurrentGroup(item.items) ? ' menu-group--active' : ''}`}>
          <span>{item.label}</span>
          <ul>
            {item.items.map((child) => <li class={child.secondary ? 'menu-group__item--secondary' : undefined}><a href={child.href} aria-current={isCurrentPage(child.href) ? 'page' : undefined}>{child.label}</a></li>)}
          </ul>
        </li>
      ) : <li><a href={item.href} aria-current={isCurrentPage(item.href) ? 'page' : undefined}>{item.label}</a></li>)}
    </ul>
    <div class="menu-language"><LanguageSwitcher {locale} {currentPath} /></div>
    <a class="menu-cta" href={consultationHref}>{consultationLabel}</a>
    <a class="menu-quick-action" href={contactLinks.whatsapp.href}>{whatsappLabel}</a>
  </nav>
</details>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  const closeButton = menu?.querySelector<HTMLButtonElement>('.menu-close');

  const closeMenu = () => {
    if (menu) menu.open = false;
  };

  closeButton?.addEventListener('click', closeMenu);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
  menu?.addEventListener('toggle', () => {
    document.body.style.overflow = menu.open ? 'hidden' : '';
  });
</script>

<style>
  .mobile-menu { position: relative; z-index: 30; }
  summary { min-height: 48px; display: inline-flex; align-items: center; cursor: pointer; font-weight: var(--font-weight-semibold); }
  nav { position: fixed; inset: 0; display: none; grid-template-rows: auto 1fr auto auto; align-content: start; z-index: 40; min-height: 100dvh; overflow-y: auto; overscroll-behavior: contain; padding: var(--space-20); background: var(--color-warm-white); box-shadow: var(--shadow-soft); }
  .mobile-menu[open] nav { display: grid; }
  .menu-sheet__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-20); padding-bottom: var(--space-16); border-bottom: 1px solid rgb(216 199 173 / 65%); }
  .menu-brand { display: inline-flex; border-radius: 50%; }
  .menu-brand img { width: 56px; height: 56px; }
  .menu-close { display: grid; width: 48px; height: 48px; place-items: center; border: 1px solid var(--color-sand); border-radius: 50%; background: transparent; color: var(--color-deep-forest); font-family: inherit; font-size: 32px; line-height: 1; cursor: pointer; }
  .menu-close:focus-visible { outline: 3px solid var(--color-sage-green); outline-offset: 3px; }
  ul { display: grid; gap: var(--space-8); margin: 0 0 var(--space-20); padding: 0; list-style: none; }
  li a { display: flex; min-height: 48px; align-items: center; text-decoration: none; }
  li a[aria-current='page'] { padding-left: var(--space-12); border-left: 2px solid var(--color-sage-green); color: var(--color-deep-forest); font-weight: var(--font-weight-semibold); }
  .menu-group { display: grid; gap: var(--space-4); padding: var(--space-8) 0; border-top: 1px solid rgb(216 199 173 / 55%); }
  .menu-group > span { color: var(--color-text-primary); font-size: var(--font-size-small); font-weight: var(--font-weight-semibold); }
  .menu-group--active > span { color: var(--color-deep-forest); }
  .menu-group ul { gap: 0; margin: 0; padding-left: var(--space-12); }
  .menu-group li a { min-height: 44px; color: var(--color-text-secondary); }
  .menu-group__item--secondary { margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px solid rgb(216 199 173 / 55%); }
  .menu-language { display: flex; margin: 0 0 var(--space-20); padding: var(--space-12) 0; border-top: 1px solid var(--color-sand); border-bottom: 1px solid var(--color-sand); }
  .menu-cta { display: flex; min-height: 48px; align-items: center; justify-content: center; padding: var(--space-12) var(--space-16); border-radius: var(--radius-button); background: var(--color-deep-forest); color: var(--color-warm-white); font-weight: var(--font-weight-semibold); text-decoration: none; }
  .menu-quick-action { display: flex; min-height: 48px; align-items: center; justify-content: center; margin-top: var(--space-12); padding: var(--space-12) var(--space-16); border: 1px solid var(--color-deep-forest); border-radius: var(--radius-button); color: var(--color-deep-forest); font-weight: var(--font-weight-semibold); text-decoration: none; }
  @media (min-width: 1180px) { .mobile-menu { display: none; } }

  /* Refined mobile menu. Original grouped links and actions are preserved. */
  .mobile-menu > summary {
    min-height:40px;
    padding:8px 13px;
    color:#284433;
    font-size:.82rem;
    font-weight:650;
    letter-spacing:.025em;
    border:1px solid rgba(126,149,118,.32);
    border-radius:11px;
    background:rgba(233,239,229,.65);
    transition:background .2s ease,border-color .2s ease;
  }
  .mobile-menu > summary:hover,
  .mobile-menu > summary:focus-visible {
    background:#e6eee2;
    border-color:#91ad90;
  }
  .mobile-menu > nav {
    box-sizing:border-box;
    padding:clamp(20px,4.6vw,42px);
    background:#faf7f1;
    color:#263d32;
    box-shadow:0 0 35px rgba(31,53,38,.11);
    grid-template-rows:auto 1fr auto auto;
    gap:0;
  }
  .menu-sheet__top {
    margin-bottom:14px;
    border-bottom:1px solid rgba(126,154,127,.22);
    padding-bottom:20px;
  }
  .menu-close {
    background:#edf2e9;
    color:#284637;
    border-color:rgba(103,137,109,.34);
    font-size:29px;
    transition:background .2s ease;
  }
  .menu-close:hover {background:#e1eadb;}
  .mobile-menu nav > ul {
    align-content:start;
    gap:1px;
    margin:0 0 22px;
  }
  .mobile-menu nav > ul > li:not(.menu-group) > a {
    font-family:Georgia,"Times New Roman",serif;
    font-size:1.32rem;
    font-weight:500;
    letter-spacing:-.016em;
    color:#263d32;
    padding:8px 4px;
    min-height:51px;
  }
  .mobile-menu nav > ul > li:not(.menu-group) > a:hover {
    color:#638363;
  }
  .menu-group {
    border-color:rgba(112,142,113,.23);
    margin:5px 0;
    gap:0;
    padding:10px 0;
  }
  .menu-group > span {
    font-family:Georgia,"Times New Roman",serif;
    font-weight:500;
    letter-spacing:-.016em;
    color:#263d32;
    font-size:1.32rem;
  }
  .menu-group ul {
    margin:9px 0 0;
    padding-left:13px;
    border-left:1px solid rgba(115,152,115,.27);
  }
  .menu-group li a {
    min-height:40px;
    color:#596f60;
    font-size:.9rem;
    padding:8px 10px;
    border-radius:8px;
  }
  .menu-group li a:hover,.menu-group li a:focus-visible {
    color:#264835;
    background:#eaf0e6;
  }
  .menu-group li a[aria-current='page'] {
    color:#284a36;
    border-left:2px solid #709a73;
    background:#e9efe5;
    font-weight:700;
  }
  .menu-language {
    border-color:rgba(118,151,119,.22);
    padding-block:14px;
    margin-bottom:15px;
  }
  .menu-cta,.menu-quick-action {
    min-height:48px;
    border-radius:12px;
    font-size:.89rem;
    font-weight:700;
    transition:background .2s ease,border-color .2s ease;
  }
  .menu-cta {background:#263d32;}
  .menu-cta:hover {background:#365a43;}
  .menu-quick-action {border-color:#9daf9b;color:#263d32;}
  .menu-quick-action:hover {background:#ebf1e6;border-color:#6e9975;}
  @media (prefers-reduced-motion:reduce) {
    .mobile-menu a,.mobile-menu button {transition:none;}
  }

</style>
