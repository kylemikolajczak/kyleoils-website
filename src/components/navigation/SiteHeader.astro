---
import { groupedEnglishMainNavigation, groupedMainNavigation } from '../../data/navigation';
import type { Locale } from '../../data/locales';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  locale?: Locale;
  currentPath: string;
}

const { locale = 'de', currentPath } = Astro.props;
const navigation = locale === 'de' ? groupedMainNavigation : groupedEnglishMainNavigation;
const homeHref = locale === 'de' ? '/de/' : '/en/';
const claim = locale === 'de' ? 'Natürliche Routinen. Persönliche Beratung.' : 'Natural routines. Personal support.';
const navigationLabel = locale === 'de' ? 'Hauptnavigation' : 'Main navigation';
const consultationHref = locale === 'de' ? '/de/kontakt/' : '/en/contact/';
const consultationLabel = locale === 'de' ? 'Beratung anfragen' : 'Request a Consultation';
const brandLabel = locale === 'de' ? 'Zur Startseite von Kyle Oils' : 'Go to the Kyle Oils homepage';

const normalizedPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const isCurrentPage = (href: string) => href === homeHref
  ? normalizedPath === href
  : normalizedPath === href || normalizedPath.startsWith(href);
const isCurrentGroup = (items: readonly { href: string }[]) => items.some((item) => isCurrentPage(item.href));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homeHref} aria-label={brandLabel}>
      <img class="brand__mark" src="/assets/images/optimized/kyle-oils-mark-128.png" alt="" width="64" height="64" />
      <span class="brand__copy">
        <span>Kyle Daniel Mikolajczak</span>
        <small>{claim}</small>
      </span>
    </a>
    <nav class="desktop-navigation" aria-label={navigationLabel}>
      <ul>
        {navigation.map((item) => 'items' in item ? (
          <li class={`nav-group${isCurrentGroup(item.items) ? ' nav-group--active' : ''}`}>
            <details>
              <summary>{item.label}</summary>
              <ul class="nav-group__menu">
                {item.items.map((child) => <li class={child.secondary ? 'nav-group__menu-item--secondary' : undefined}><a href={child.href} aria-current={isCurrentPage(child.href) ? 'page' : undefined}>{child.label}</a></li>)}
              </ul>
            </details>
          </li>
        ) : <li><a href={item.href} aria-current={isCurrentPage(item.href) ? 'page' : undefined}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="desktop-language"><LanguageSwitcher {locale} {currentPath} /></div>
    <a class="header-cta" href={consultationHref}>{consultationLabel}</a>
    <MobileMenu {locale} {currentPath} />
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid rgb(216 199 173 / 55%); background: var(--color-warm-white); }
  .header-inner { min-height: 72px; display: flex; align-items: center; gap: var(--space-24); }
  .brand { margin-right: auto; display: flex; align-items: center; gap: var(--space-12); color: var(--color-text-primary); font-weight: var(--font-weight-semibold); line-height: 1.2; text-decoration: none; }
  .brand__mark { width: 56px; height: 56px; flex: 0 0 auto; }
  .brand__copy { display: grid; }
  .brand small { display: none; color: var(--color-text-secondary); font-size: 12px; font-weight: var(--font-weight-regular); }
  .desktop-navigation, .desktop-language, .header-cta { display: none; }
  .desktop-navigation > ul { display: flex; gap: var(--space-16); margin: 0; padding: 0; list-style: none; }
  .desktop-navigation a, summary { position: relative; display: flex; min-height: 48px; align-items: center; color: var(--color-text-primary); font-size: var(--font-size-small); text-decoration: none; }
  .desktop-navigation > ul > li > a::after, summary::before { content: ''; position: absolute; right: 0; bottom: 4px; left: 0; height: 2px; border-radius: var(--radius-pill); background: var(--color-sage-green); opacity: 0; transform: scaleX(.5); transition: opacity 160ms ease, transform 160ms ease; }
  .desktop-navigation > ul > li > a[aria-current='page'], .nav-group--active summary { color: var(--color-deep-forest); font-weight: var(--font-weight-semibold); }
  .desktop-navigation > ul > li > a[aria-current='page']::after, .nav-group--active summary::before { opacity: 1; transform: scaleX(1); }
  .nav-group { position: relative; }
  details { position: relative; }
  summary { gap: var(--space-4); cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '▾'; color: var(--color-olive-grey); font-size: .72em; transition: transform 160ms ease; }
  details[open] summary::after { transform: rotate(180deg); }
  .nav-group__menu { position: absolute; top: calc(100% - var(--space-4)); left: calc(var(--space-16) * -1); z-index: 20; display: none; width: max-content; min-width: 210px; margin: 0; padding: var(--space-8); border: 1px solid var(--color-sand); border-radius: var(--radius-card); background: var(--color-warm-white); box-shadow: var(--shadow-soft); list-style: none; }
  details[open] .nav-group__menu, details:hover .nav-group__menu, details:focus-within .nav-group__menu { display: grid; }
  .nav-group__menu a { min-height: 44px; padding: 0 var(--space-12); border-radius: var(--radius-button); }
  .nav-group__menu-item--secondary { margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px solid rgb(216 199 173 / 70%); }
  .nav-group__menu a:hover, .nav-group__menu a:focus-visible { background: var(--color-soft-cream); }
  .nav-group__menu a[aria-current='page'] { color: var(--color-deep-forest); font-weight: var(--font-weight-semibold); }
  .header-cta { min-height: 48px; align-items: center; padding: 0 var(--space-20); border-radius: var(--radius-button); background: var(--color-deep-forest); color: var(--color-warm-white); font-size: var(--font-size-small); font-weight: var(--font-weight-semibold); text-decoration: none; }
  @media (min-width: 520px) { .brand small { display: block; } }
  @media (min-width: 1180px) { .header-inner { min-height: 88px; } .brand__mark { width: 64px; height: 64px; } .desktop-navigation, .desktop-language, .header-cta { display: flex; } .desktop-language { align-items: center; } }

  /* Kyle Oils Global Navigation • visual refinement only; original routes and scroll behavior stay intact. */
  .site-header {
    position: relative;
    z-index: 45;
    background: rgb(250 247 241 / 98%);
    border-bottom: 1px solid rgb(116 137 113 / 19%);
    box-shadow: 0 8px 24px rgb(47 62 49 / 3%);
  }
  .header-inner { gap: clamp(12px, 1.35vw, 20px); }
  .brand {
    min-width: 0;
    flex: 0 1 auto;
    gap: 12px;
    color: #263d32;
    transition: opacity 200ms ease;
  }
  .brand:hover { opacity: .8; }
  .brand__mark {
    flex: 0 0 auto;
    filter: drop-shadow(0 2px 3px rgb(36 63 45 / 10%));
  }
  .brand__copy { min-width:0; gap:2px; }
  .brand__copy > span {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 500;
    font-size: clamp(15.5px,1.42vw,19px);
    line-height: 1.14;
    letter-spacing: -.024em;
    white-space: nowrap;
    color:#263d32;
  }
  .brand small {
    color:#758271;
    font-size: 10.5px;
    line-height:1.3;
    letter-spacing:.035em;
    white-space:nowrap;
  }
  .desktop-navigation { margin-left:auto; }
  .desktop-navigation > ul { align-items:center; gap:clamp(8px,.9vw,14px); }
  .desktop-navigation a,
  summary {
    min-height:43px;
    font-size:12.5px;
    font-weight:550;
    letter-spacing:.012em;
    color:#485b4b;
    white-space:nowrap;
    transition: color 180ms ease;
  }
  .desktop-navigation > ul > li > a { padding:0 1px; }
  .desktop-navigation > ul > li > a:hover,
  summary:hover,
  .nav-group:hover summary { color:#244733; }
  .desktop-navigation > ul > li > a::after,
  summary::before {
    height:1.5px;
    bottom:2px;
    background:#739875;
    transition:opacity 180ms ease,transform 200ms ease;
  }
  .desktop-navigation > ul > li > a:hover::after,
  summary:hover::before {opacity:.7; transform:scaleX(1);}
  summary {gap:8px;}
  summary::after {
    content:"";
    display:inline-block;
    width:6px;
    height:6px;
    border-right:1.4px solid #658468;
    border-bottom:1.4px solid #658468;
    transform:rotate(45deg) translateY(-1px);
    transition:transform .2s ease;
  }
  details[open] summary::after { transform:rotate(225deg) translate(-2px,-2px); }
  .nav-group__menu {
    top:calc(100% + 6px);
    left:-15px;
    z-index:60;
    min-width:225px;
    padding:9px;
    border-radius:18px;
    border:1px solid rgba(131,154,126,.26);
    background:rgb(250 248 243 / 99%);
    box-shadow:0 15px 42px rgb(31 57 40 / 12%);
  }
  .nav-group__menu a {
    min-height:45px;
    color:#354f3d;
    font-size:13px;
    white-space:normal;
    line-height:1.3;
    padding:9px 12px;
    border-radius:10px;
    transition:background .18s ease,color .18s ease;
  }
  .nav-group__menu a:hover,
  .nav-group__menu a:focus-visible {
    color:#263d32;
    background:#e9efe6;
    text-decoration:none;
  }
  .nav-group__menu a[aria-current='page'] {background:#e9efe6;}
  .nav-group__menu-item--secondary {
    margin-top:5px;
    padding-top:6px;
    border-color:rgba(126,152,122,.22);
  }
  .header-cta {
    white-space:nowrap;
    min-height:45px;
    padding:0 clamp(14px,1.55vw,22px);
    background:#263d32;
    color:#faf7f1;
    border:1px solid #263d32;
    border-radius:12px;
    font-size:12.5px;
    font-weight:700;
    letter-spacing:.005em;
    box-shadow:0 5px 14px rgba(38,61,50,.1);
    transition:background .22s ease,box-shadow .22s ease,transform .22s ease;
  }
  .header-cta:hover,
  .header-cta:focus-visible {
    color:#fffdf7;
    background:#365b45;
    box-shadow:0 8px 19px rgba(38,61,50,.18);
    transform:translateY(-1px);
  }
  .desktop-language { flex-shrink:0; }
  @media (min-width:1180px) {
    .brand { margin-right:0; }
    .header-inner { min-height:94px; }
    .brand__mark { width:68px; height:68px; }
  }
  @media (min-width:1180px) and (max-width:1280px) {
    .header-inner {gap:12px;}
    .brand__copy > span {font-size:16px;}
    .brand small {font-size:9px;}
    .brand__mark {width:59px;height:59px;}
    .desktop-navigation > ul {gap:8px;}
    .desktop-navigation a,summary {font-size:11.5px;}
    .header-cta {font-size:11.5px;padding-inline:13px;}
  }
  @media (max-width:1179px) {
    .brand {margin-right:auto;}
    .header-inner {min-height:80px;}
    .brand__mark {width:59px;height:59px;}
  }
  @media (max-width:519px) {
    .brand__mark {width:54px;height:54px;}
    .brand__copy > span {font-size:15px;white-space:normal;}
    .header-inner {gap:9px;}
  }
  @media (prefers-reduced-motion: reduce) {
    .brand,.header-cta,.nav-group__menu a {transition:none;}
  }



  /* Sitewide call-to-action uses the same typographic logic as standard buttons. */
  .header-cta {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    font-size: clamp(.8rem, .95vw, .86rem);
    font-weight: 650;
    letter-spacing: .012em;
    line-height: 1.3;
    text-align: center;
  }
  @media (min-width: 1180px) and (max-width: 1280px) {
    .header-cta { font-size: .76rem; }
  }

</style>
