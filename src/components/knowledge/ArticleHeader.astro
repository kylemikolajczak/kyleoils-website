---
import Breadcrumbs from './Breadcrumbs.astro';
import type { BreadcrumbItem } from '../../data/knowledge';

interface Props {
  breadcrumbs: BreadcrumbItem[];
  worldLabel: string;
  title: string;
  intro: string;
  reviewLine?: string;
}
const { breadcrumbs, worldLabel, title, intro, reviewLine } = Astro.props;
---

<header class="article-header">
  <div class="knowledge-container">
    <Breadcrumbs items={breadcrumbs} />
    <p class="article-header__world">{worldLabel}</p>
    <h1>{title}</h1>
    <p class="article-header__intro">{intro}</p>
    {reviewLine && <p class="article-header__review">{reviewLine}</p>}
  </div>
</header>

<style>
  .article-header { padding: var(--space-48) 0 var(--space-40); background: var(--color-warm-white); }
  .knowledge-container { width: min(100% - (2 * var(--gutter-mobile)), var(--container-text)); margin-inline: auto; }
  .article-header__world { margin: 0 0 var(--space-12); color: var(--color-olive-grey); font-size: var(--font-size-small); font-weight: var(--font-weight-semibold); letter-spacing: .04em; text-transform: uppercase; }
  h1 { margin: 0 0 var(--space-20); font-size: var(--font-size-h1-mobile); line-height: var(--line-height-heading); letter-spacing: -.025em; }
  .article-header__intro { margin: 0; color: var(--color-text-secondary); font-size: 19px; }
  .article-header__review { margin: var(--space-20) 0 0; color: var(--color-text-muted); font-size: var(--font-size-small); }
  @media (min-width: 768px) { .knowledge-container { width: min(100% - (2 * var(--gutter-tablet)), var(--container-text)); } .article-header { padding-block: var(--space-64); } }
  @media (min-width: 1024px) { .knowledge-container { width: min(100% - (2 * var(--gutter-desktop)), var(--container-text)); } h1 { font-size: var(--font-size-h1-desktop); } }
</style>
