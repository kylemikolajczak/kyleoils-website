---
import ComplianceNote from '../../../components/compliance/ComplianceNote.astro';
import CTASection from '../../../components/cta/CTASection.astro';
import HeroSplit from '../../../components/sections/HeroSplit.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import '../../../styles/business-opportunity-refined.css';

const responsiblePractice = [
  'Knowing and understanding the products yourself',
  'Offering honest guidance and answering questions',
  'Explaining responsible everyday use clearly',
  'Supporting customers after their first purchase',
  'Discussing business only when there is genuine interest',
];

const couldFit = [
  'You genuinely enjoy doTERRA products and sharing your experience.',
  'You like helping people with clear, honest guidance.',
  'You are curious, willing to learn and comfortable asking questions.',
  'You value a responsible, long-term approach.',
  'You want to understand products and customers before building a team.',
];

const customerFirstSteps = [
  { title: '1. Get to know doTERRA', paragraphs: [] },
  { title: '2. Understand products and starter kits', paragraphs: [] },
  { title: '3. Find your own routines', paragraphs: [] },
  { title: '4. Gain experience and talk through questions', paragraphs: [] },
  { title: '5. Only then consider a possible business role', paragraphs: [] },
];

const conversationQuestions = [
  'Why does the business opportunity interest you?',
  'Which products and experiences would you genuinely like to share?',
  'How much time and energy do you realistically have?',
  'Does a gradual, responsible approach fit you?',
  'Which expectations should be clear from the start?',
];
---

<PageLayout lang="en" title="The doTERRA Business Opportunity | Kyle Oils" description="Honest guidance on the doTERRA business opportunity: understand products first, support people responsibly and place expectations in a realistic context.">
  <HeroSplit title="The doTERRA Business Opportunity" primaryHref="/en/contact/" primaryLabel="Discuss the Business Opportunity" secondaryHref="/en/consultation/" secondaryLabel="Request Guidance First" imageSrc="/assets/images/business/business-kyle-hero.jpg" imageAlt="Kyle in a calm working environment" imageWidth={1023} imageHeight={1537} imagePosition="66% center">
    <p class="core-message">Build something of your own, rooted in what you love.</p>
    <p>If you enjoy essential oils, like learning and naturally share useful experiences, you may want to explore developing an independent business over time.</p>
    <p>I can explain what getting started involves, the responsibilities of a Wellness Advocate and what matters for a sustainable long-term approach.</p>
  </HeroSplit>

  <section class="section business-values" aria-labelledby="business-values-title">
    <div class="container business-wrap business-values__grid" data-reveal>
      <div class="business-values__intro">
        <p class="eyebrow">WHAT REALLY MATTERS</p>
        <h2 id="business-values-title">A business built around people.</h2>
        <p>As an independent doTERRA Wellness Advocate, you can recommend products, share education and support customers over time. At Kyle Oils, five principles guide that work.</p>
        <p class="business-values__note">Build trust first. Discuss business only when there is genuine interest.</p>
      </div>
      <div class="business-values__list">
        <ol>{responsiblePractice.map((item,index)=><li>
          <span class="business-num" aria-hidden="true">{String(index+1).padStart(2,"0")}</span>
          <span>{item}</span>
        </li>)}</ol>
      </div>
    </div>
  </section>

  <section class="section business-fit" aria-labelledby="business-fit-title">
    <div class="container business-wrap">
      <header class="business-heading" data-reveal>
        <p class="eyebrow">IS IT FOR YOU?</p>
        <h2 id="business-fit-title">Could this be your kind of opportunity?</h2>
        <p>You do not need a perfect plan. Genuine product interest, curiosity and a willingness to support people over time matter much more.</p>
      </header>
      <div class="business-fit__grid" data-consultation-cards>
        {couldFit.map((item,index)=><article class="business-fit-card" data-consultation-card>
          <span class="business-num" aria-hidden="true">{String(index+1).padStart(2,"0")}</span>
          <p>{item}</p>
        </article>)}
      </div>
      <p class="business-fit__note">The aim is to build lasting relationships, not recruit people as quickly as possible.</p>
    </div>
  </section>

  <section class="section business-journey" aria-labelledby="business-journey-title">
    <div class="container business-wrap">
      <header class="business-heading" data-reveal>
        <p class="eyebrow">YOUR PATH</p>
        <h2 id="business-journey-title">Five steps toward an informed decision.</h2>
        <p>A solid starting point grows from personal experience. These steps can help you find out whether the business side genuinely appeals to you.</p>
      </header>
      <ol class="business-journey__grid" data-consultation-cards>
        {customerFirstSteps.map((step,index)=><li class="business-journey-card" data-consultation-card>
          <span class="business-journey-card__num" aria-hidden="true">{String(index+1).padStart(2,"0")}</span>
          <h3>{step.title.replace(/^\d+\.\s*/, "")}</h3>
        </li>)}
      </ol>
      <p class="business-journey__note">This is a possible approach, not a mandatory programme or a guarantee of results.</p>
    </div>
  </section>

  <section class="section business-discussion" aria-labelledby="business-discussion-title">
    <div class="container business-wrap business-discussion__grid" data-reveal>
      <div class="business-discussion__intro">
        <p class="eyebrow">LET’S TALK ABOUT IT</p>
        <h2 id="business-discussion-title">What could your next step look like?</h2>
        <p>In a personal conversation, we can explore your interests, experience and expectations, and whether the doTERRA opportunity is a sensible fit.</p>
        <p class="business-discussion__disclosure">Before deciding, we should review the current official compensation plan, possible costs and company rules together.</p>
      </div>
      <div class="business-discussion__card">
        <p class="eyebrow">QUESTIONS WE CAN DISCUSS</p>
        <ol>{conversationQuestions.map((q,index)=><li>
          <span class="business-num" aria-hidden="true">{String(index+1).padStart(2,"0")}</span>
          <span>{q}</span>
        </li>)}</ol>
      </div>
    </div>
  </section>

  <CTASection title="Let’s explore your business idea." primaryHref="/en/contact/" primaryLabel="Ask about the business" secondaryHref="/en/consultation/" secondaryLabel="Explore products first">
    <p>Thinking about an independent doTERRA business? Tell me what interests you, and I can explain how the opportunity works without making income promises.</p>
  </CTASection>
  <section class="compliance-section business-compliance"><div class="container">
    <ComplianceNote label="IMPORTANT NOTE">
      <p class="business-compliance__label">IMPORTANT NOTE</p>
      <p>Building an independent doTERRA business involves effort and business risk. Income or success is never guaranteed. Refer to current official doTERRA policies and compensation information. Kyle Oils does not provide legal, tax or financial advice.</p>
    </ComplianceNote>
  </div></section>
  <script is:inline src="/scripts/consultation-motion.js" defer></script>
</PageLayout>
