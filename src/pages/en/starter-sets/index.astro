---
import StarterSetCard from '../../../components/cards/StarterSetCard.astro';
import ComplianceNote from '../../../components/compliance/ComplianceNote.astro';
import CTASection from '../../../components/cta/CTASection.astro';
import ResponsiveImage from '../../../components/global/ResponsiveImage.astro';
import { starterSetLinks } from '../../../data/starterSets';
import PageLayout from '../../../layouts/PageLayout.astro';
import '../../../styles/starter-sets-refined.css';
import { contactLinks } from '../../../data/externalLinks';

const starterSets = [
  {
    anchorId: 'family-essentials-kit',
    title: 'Family Essentials Kit',
    lead: 'The simplest introduction to the world of essential oils.',
    imageSrc: '/assets/images/products/starter-family-essentials.png',
    imageAlt: 'Family Essentials Kit with a selection of essential oils',
    imageWidth: 962,
    imageHeight: 1350,
    orderLabel: 'Official doTERRA Shop · Germany',
    orderHref: starterSetLinks[0].href,
    sections: [
      {
        title: 'Who Is It Suitable For?',
        items: [
          'a compact starting point for beginners',
          'particularly helpful for families and people who want to begin with a manageable selection',
        ],
      },
      {
        title: 'How Does It Help You Begin?',
        items: [
          '10 popular essential oils and oil blends',
          'not an overly large starter package',
        ],
      },
      {
        title: 'Main Focus',
        items: [
          'designed for exploring different daily uses',
        ],
      },
      {
        title: 'Kyle’s Honest View',
        paragraphs: [
          'When someone asks me, “I would simply like to explore essential oils. Where should I begin?”, this is often the first kit I think of. It offers a straightforward and manageable introduction without becoming too extensive.',
        ],
      },
    ],
  },
  {
    anchorId: 'home-essentials-kit',
    title: 'Home Essentials Kit',
    lead: 'A more comprehensive introduction for the home and regular use.',
    imageSrc: '/assets/images/products/starter-home-essentials.png',
    imageAlt: 'Home Essentials Kit with a diffuser and essential oils',
    imageWidth: 672,
    imageHeight: 256,
    orderLabel: 'Official doTERRA Shop · Germany',
    orderHref: starterSetLinks[1].href,
    sections: [
      {
        title: 'Who Is It Suitable For?',
        items: [
          'for people who want to use essential oils regularly at home',
          'a solid basic selection for the home',
        ],
      },
      {
        title: 'How Does It Help You Begin?',
        items: [
          'more comprehensive than the Family Essentials Kit',
          'includes a Petal Diffuser',
          'includes larger 15 ml bottles',
        ],
      },
      {
        title: 'Main Focus',
        items: [
          'designed for different daily needs and routines',
        ],
      },
      {
        title: 'Kyle’s Honest View',
        paragraphs: [
          'If you already know that you want to use essential oils regularly, I would often be more likely to suggest this kit. The included diffuser and larger bottles make it particularly interesting if you are looking for a broader basic selection for your home.',
        ],
      },
    ],
  },
  {
    anchorId: 'wellness-made-simple',
    title: 'Wellness Made Simple',
    lead: 'A structured introduction to daily wellness and nutritional supplement routines.',
    imageSrc: '/assets/images/products/starter-wellness-made-simple.png',
    imageAlt: 'Wellness Made Simple with products for daily wellness routines',
    imageWidth: 654,
    imageHeight: 358,
    orderLabel: 'Official doTERRA Shop · Germany',
    orderHref: starterSetLinks[2].href,
    sections: [
      {
        title: 'Who Is It Suitable For?',
        items: [
          'for people who want to take a more holistic and structured approach to their daily wellness routine',
        ],
      },
      {
        title: 'How Does It Help You Begin?',
        items: [
          'daily nutritional supplements',
          'micronutrients',
          'omega fatty acids',
          'products designed to complement a balanced daily wellness routine, including digestive wellbeing',
        ],
      },
      {
        title: 'Main Focus',
        items: [
          'long-term wellness routines',
          'essential oils complement the concept but are not the sole focus',
        ],
      },
      {
        title: 'Kyle’s Honest View',
        paragraphs: [
          'This option is particularly interesting if you are not just looking for individual products, but want to build a structured daily wellness routine. Nutritional supplements, omega fatty acids and a structured daily routine take greater prominence here than individual essential oils.',
        ],
      },
    ],
  },
  {
    anchorId: 'metapwr-system',
    title: 'MetaPWR System',
    lead: 'A system-oriented introduction for active people and long-term habits.',
    imageSrc: '/assets/images/products/starter-metapwr.png',
    imageAlt: 'MetaPWR System with nutritional supplements and an essential oil blend',
    imageWidth: 3120,
    imageHeight: 1350,
    orderLabel: 'Official doTERRA Shop · Germany',
    orderHref: starterSetLinks[3].href,
    sections: [
      {
        title: 'Who Is It Suitable For?',
        items: [
          'for active people',
          'not automatically the best first choice for everyone',
        ],
      },
      {
        title: 'How Does It Help You Begin?',
        items: [
          'not a traditional essential oil starter kit',
          'a coordinated wellness system',
          'nutritional supplements and essential oils as an integrated system',
        ],
      },
      {
        title: 'Main Focus',
        items: [
          'considered routines around movement, energy and metabolic awareness',
          'long-term habits rather than individual products',
        ],
      },
      {
        title: 'Kyle’s Honest View',
        paragraphs: [
          'I would not automatically recommend MetaPWR to everyone as a first introduction. It can be very interesting if you are specifically looking for a coordinated system and are ready to build considered routines into your daily life over the long term.',
        ],
      },
    ],
  },
];

const decisionGuides = [
  { title: 'Which doTERRA Starter Kit Fits Me?', href: '/en/knowledge/products-systems/which-doterra-starter-kit-fits-me/' },
  { title: 'How the doTERRA LRP Loyalty Program Works', href: '/en/knowledge/products-systems/lrp-loyalty-program-explained-calmly/' },
  { title: 'doTERRA Customer Account Explained Simply', href: '/en/knowledge/products-systems/doterra-customer-account-explained-simply/' },
];

const decisionOptions = [
  { title: 'A simple essential-oil starting point', copy: 'Family Essentials Kit for a manageable introduction to essential oils.', href: '#family-essentials-kit' },
  { title: 'Home & diffuser', copy: 'Home Essentials Kit for a broader home setup including a diffuser.', href: '#home-essentials-kit' },
  { title: 'A daily wellness routine', copy: 'Wellness Made Simple for a more structured product introduction.', href: '#wellness-made-simple' },
  { title: 'A system-focused start', copy: 'MetaPWR System for people considering a coordinated system.', href: '#metapwr-system' },
];
---

<PageLayout lang="en" title="A better start begins with the right kit. | Kyle Oils" description="Four official starter options, explained clearly. Choose what fits your life, build useful habits and discover the benefits of a doTERRA customer account.">
  <section class="hero starter-sets-hero">
    <div class="container hero__grid">
      <div class="hero__content">
        <p class="eyebrow">START WITH DOTERRA</p>
        <h1>A better start begins with the right kit.</h1>
        <div class="hero__copy"><p>Four official starter options, explained clearly. Choose what fits your life, build useful habits and discover the benefits of a doTERRA customer account.</p></div>
        <p class="starter-hero__deal"><strong>25 %</strong><span>below regular retail with eligible customer membership. This is not an extra reduction on the displayed kit price.</span></p>
        <div class="starter-hero__buttons"><a class="starter-button starter-button--primary" href="#starter-options">Explore kit</a><a class="starter-button starter-button--secondary" href="/en/contact/">Ask Kyle for guidance</a></div>
      </div>
      <ResponsiveImage
        src="/assets/images/products/starter-sets-hero-lifestyle.png"
        alt="Diffuser, essential oils and a cup in a calm setting"
        width={1672}
        height={941}
        variant="portrait-wide"
        position="67% center"
        treatment="hero"
        priority
        sources={[
          { type: 'image/avif', srcset: '/assets/images/optimized/starter-sets-hero-lifestyle-640.avif 640w, /assets/images/optimized/starter-sets-hero-lifestyle-960.avif 960w, /assets/images/optimized/starter-sets-hero-lifestyle-1280.avif 1280w' },
          { type: 'image/webp', srcset: '/assets/images/optimized/starter-sets-hero-lifestyle-640.webp 640w, /assets/images/optimized/starter-sets-hero-lifestyle-960.webp 960w, /assets/images/optimized/starter-sets-hero-lifestyle-1280.webp 1280w' },
        ]}
      />
    </div>
  </section>
  <section class="section starter-decision">
    <div class="container starter-main-container">
      <header class="starter-section-heading" data-reveal><p class="eyebrow">FIND YOUR STARTING POINT</p><h2>Which kit fits your everyday life?</h2><p>Four different ways to begin. Choose what matters to you and explore the matching starter kit.</p></header>
      <div class="starter-decision__grid" data-consultation-cards>
      {decisionOptions.map((option,index)=><a class="starter-decision__card" href={option.href} data-consultation-card>
        <span class="starter-card-index">{String(index+1).padStart(2,"0")}</span><h3>{option.title}</h3><p>{option.copy}</p><span class="starter-card-more">Explore kit ↗</span>
      </a>)}
      </div>
    </div>
  </section>
  <section class="section starter-offers" id="starter-options">
    <div class="container starter-main-container">
      <header class="starter-section-heading" data-reveal><p class="eyebrow">FOUR OFFICIAL OPTIONS</p><h2>Explore the starter kits.</h2><p>View the products, their everyday uses and my personal take. All direct order buttons on this page link to the German doTERRA shop.</p></header>
      <aside class="starter-international">
        <div class="starter-international__copy"><p class="eyebrow">IMPORTANT FOR INTERNATIONAL VISITORS</p><h3>Living outside Germany? Contact me first.</h3><p>Every direct order button on this page links to the official German doTERRA shop and is intended for Germany. Tell me which country you live in and which kit interests you. I can check locally available official options and guide you to your country’s appropriate ordering and customer enrolment process.</p><small>Availability, currencies, eligibility and prices vary by country.</small></div>
        <a href="/en/contact/" class="starter-button starter-button--primary">Ask for your country’s ordering options</a>
      </aside>
      <aside class="starter-pricing"><strong>25 %</strong><div><p class="eyebrow">25% WHOLESALE CUSTOMER BENEFIT</p><p>With an eligible doTERRA Wholesale Customer account, you can shop at wholesale pricing, generally 25% below regular retail. This is not an additional 25% reduction on an already listed starter-kit price. I can guide you through your available enrolment and ordering options.</p></div></aside>
      <div class="starter-set-list">
        {starterSets.map((set,index)=><div id={set.anchorId} class="starter-set-anchor" tabindex="-1">
          <StarterSetCard title={set.title} imageSrc={set.imageSrc} imageAlt={set.imageAlt} imageWidth={set.imageWidth} imageHeight={set.imageHeight}
            orderHref={set.orderHref} orderLabel="Order from German doTERRA shop" consultationHref="/en/contact/" consultationLabel="Outside Germany? Ask Kyle"
            kitIndex={index+1} countryLabel="OFFICIAL SHOP · GERMANY ONLY" priceNotice="Eligible member pricing is 25% below regular retail, not an extra discount on displayed starter-kit prices.">
              <p class="starter-set-lead">{set.lead}</p>
              {set.sections.map((section)=><section><h4>{section.title}</h4>
                {"items" in section && <ul class="starter-set-points">{section.items.map(item=><li>{item}</li>)}</ul>}
                {"paragraphs" in section && section.paragraphs.map(paragraph=><p>{paragraph}</p>)}
              </section>)}
          </StarterSetCard>
        </div>)}
      </div>
    </div>
  </section>
  <section class="section starter-benefits">
    <div class="container starter-main-container starter-benefits__grid">
      <article class="starter-benefits__account" data-reveal><p class="eyebrow">YOUR CUSTOMER BENEFITS</p><h2>An account with real benefits.</h2><p>With a suitable doTERRA Wholesale Customer account, you gain access to member pricing and have me as a personal guide for your first products and routines.</p><ul><li><span>01</span><p>Wholesale prices 25% below regular retail, where eligible</p></li><li><span>02</span><p>Personal guidance on enrolment, kit choice and safe use</p></li><li><span>03</span><p>No mandatory monthly order for Wholesale Customer membership</p></li></ul></article>
      <article class="starter-benefits__before" data-reveal><p class="eyebrow">BEFORE YOU ORDER</p><h2>Choose a kit you will actually use.</h2><p>Start with your needs. Are you exploring oils for the first time, looking for a diffuser or planning a specific wellness routine? The best fit is not necessarily the largest kit.</p><ul><li>An introduction to oils and family routines</li><li>A diffuser and a broader home essentials setup</li><li>Daily nutrition and wellness products</li><li>A focused approach with MetaPWR</li></ul></article>
    </div>
  </section>
  <section class="section starter-guides">
    <div class="container starter-main-container">
      <header class="starter-section-heading" data-reveal><p class="eyebrow">UNDERSTAND BEFORE YOU BUY</p><h2>Get ready for your first order.</h2><p>Three short guides explain kit choices, customer accounts and the Loyalty Rewards Program.</p></header>
      <div class="starter-guides__grid" data-consultation-cards>{decisionGuides.map((guide,index)=><a href={guide.href} class="starter-guides__card" data-consultation-card>
        <span class="starter-card-index">{String(index+1).padStart(2,"0")}</span><h3>{guide.title}</h3><span class="starter-card-more">Read guide ↗</span>
      </a>)}</div>
    </div>
  </section>
  <section class="section starter-orientation">
    <div class="container starter-main-container">
      <header class="starter-section-heading" data-reveal><p class="eyebrow">GETTING STARTED</p><h2>What happens after your first order?</h2></header>
      <div class="starter-orientation__grid">
        <article><span class="starter-card-index">01</span><h3>Start Here</h3><p>Explore responsible essential-oil use with our Start Here guides.</p><a class="starter-button starter-button--secondary" href="/en/start-here/">Explore Start Here</a></article>
        <article><span class="starter-card-index">02</span><h3>30-Day Start Plan</h3><p>Build your first everyday habits with our free 30-Day Oil Start Plan.</p><a class="starter-button starter-button--secondary" href="/en/30-day-start-plan/">View the 30-Day Start Plan</a></article>
      </div>
    </div>
  </section>
  <CTASection title="Ready to start with doTERRA?" primaryHref="/en/contact/" primaryLabel="Contact Kyle" secondaryHref={contactLinks.whatsapp.href} secondaryLabel="Message on WhatsApp"><p>If you are in Germany, choose your kit in the German shop. Living elsewhere or unsure which kit fits? Message me and I will help you explore your country’s official ordering options.</p></CTASection>
  <section class="compliance-section starter-compliance"><div class="container"><ComplianceNote label="IMPORTANT NOTE"><p class="starter-compliance__label">IMPORTANT NOTE</p><p>The 25% customer benefit refers to eligible wholesale pricing compared with regular retail; it is not an extra discount on a displayed starter-kit price. doTERRA determines availability, pricing and enrolment terms in each country. My guidance is not medical advice.</p></ComplianceNote></div></section>
  <script is:inline src="/scripts/consultation-motion.js" defer></script>
</PageLayout>
