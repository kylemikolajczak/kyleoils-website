---
import KnowledgeLandingTemplate from '../../../components/knowledge/KnowledgeLandingTemplate.astro';
import { knowledgeLanding, knowledgeWorlds } from '../../../data/knowledge';
import { englishKnowledgeArticles } from '../../../data/knowledgeArticles';
import PageLayout from '../../../layouts/PageLayout.astro';

const recommendedStartArticleIds = ['KO-W07-001', 'KO-W07-002', 'KO-W07-003', 'KO-W07-005'];
const featuredArticleIds = ['KO-W07-001', 'KO-W07-002', 'KO-W07-003', 'KO-W07-005', 'KO-W08-001', 'KO-W09-001'];
const getArticlesById = (ids: string[]) => ids.flatMap((id) => {
  const article = englishKnowledgeArticles.find((item) => item.id === id);
  return article ? [article] : [];
});
const recommendedStartArticles = getArticlesById(recommendedStartArticleIds);
const featuredArticles = getArticlesById(featuredArticleIds);
---

<PageLayout lang="en" title="Knowledge | Kyle Daniel Mikolajczak" description={knowledgeLanding.description.en}>
  <KnowledgeLandingTemplate locale="en" title={knowledgeLanding.title.en} description={knowledgeLanding.description.en} worlds={knowledgeWorlds} recommendedStartArticles={recommendedStartArticles} searchArticles={englishKnowledgeArticles} {featuredArticles} />
</PageLayout>
