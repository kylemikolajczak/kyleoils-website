---
import ComplianceNote from '../../../components/compliance/ComplianceNote.astro';
import CTASection from '../../../components/cta/CTASection.astro';
import FAQAccordion from '../../../components/faq/FAQAccordion.astro';
import Button from '../../../components/global/Button.astro';
import ResponsiveImage from '../../../components/global/ResponsiveImage.astro';
import TopicCard from '../../../components/cards/TopicCard.astro';
import TrustCard from '../../../components/cards/TrustCard.astro';
import HeroSplit from '../../../components/sections/HeroSplit.astro';
import SectionIntro from '../../../components/sections/SectionIntro.astro';
import StepList from '../../../components/sections/StepList.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import { contactLinks } from '../../../data/externalLinks';

const consultationSteps = [
  { title: '1. You Get in Touch', paragraphs: ['You briefly tell me what you would like to discuss. WhatsApp or email is completely enough.'] },
  {
    title: '2. I Listen',
    paragraphs: ['We talk about what interests you and what is realistic in your daily routine before we place any options in context.'],
  },
  {
    title: '3. We Look at Your Options',
    paragraphs: ['I explain clearly which routines, topics or doTERRA products may be relevant. The aim is clarity, not recommending as much as possible.'],
  },
  {
    title: '4. You Decide in Your Own Time',
    paragraphs: ['If something suits you, we discuss the next step: a product recommendation, a starter kit, a customer account or simply more information for the time being.'],
  },
  {
    title: '5. I Continue to Support You',
    paragraphs: ['If you get started, I remain available for questions about use and for building a routine that suits daily life.'],
  },
];

const expectations = [
  'A calm, honest assessment.',
  'Clear explanations without complicated terminology.',
  'Recommendations that suit your needs.',
  'No artificial urgency or exaggerated promises.',
  'No claims that products can diagnose, treat or cure medical conditions.',
  'Personal support as you get started and afterwards.',
];

const consultationTopics = [
  {
    title: 'Busy Days & Emotional Wellbeing',
    copy: 'For people who would like to build in small pauses, more calm and simple rituals.',
  },
  {
    title: 'Evening & Sleep Routine',
    copy: 'For anyone who wants to bring the day to a clearer close and make their evening routine more pleasant.',
  },
  {
    title: 'Movement, Massage & Body Comfort',
    copy: 'For people who want to place massage, care and scent routines after active days in context.',
  },
  {
    title: 'Food & Everyday Wellness Habits',
    copy: 'For people who want to better understand products and routines around meals, habits and everyday choices.',
  },
  {
    title: 'Emotional Scent Anchors',
    copy: 'For scent as a personal anchor for mood, memory, atmosphere, reflection and small rituals.',
  },
  {
    title: 'Fresh Home Atmosphere',
    copy: 'For simple diffuser routines, regular ventilation and a fresh-feeling home.',
  },
  {
    title: 'Family Everyday Life & Safe Use',
    copy: 'For families who want routines that take safety, amount and room size into account.',
  },
];

const consultationFaqs = [
  {
    question: 'Do I Have to Buy Anything After the Conversation?',
    answer: 'No. The conversation is first and foremost about giving you a clear starting point. You can then decide in your own time whether and how you would like to begin.',
  },
  {
    question: 'Is the Consultation Free?',
    answer: 'The first conversation is free. If special formats, workshops or detailed concepts are considered later, we discuss this clearly and transparently in advance.',
  },
  {
    question: 'Can I Write Instead of Calling?',
    answer: 'Yes. Many questions can also be clarified easily via WhatsApp or email.',
  },
  {
    question: 'Will I Receive Specific Product Recommendations?',
    answer: 'Yes, if they suit your needs. I only recommend what I believe can be explained and assessed meaningfully.',
  },
  {
    question: 'Can I Ask Questions if I Already Have doTERRA Products?',
    answer: 'Yes. If you already own products but rarely use them or feel unsure, I am happy to help you understand them.',
  },
  {
    question: 'Is This Guidance a Substitute for a Doctor or Therapist?',
    answer: 'No. My support is not a substitute for medical diagnosis or treatment. I do not claim that products can diagnose, treat or cure medical conditions.',
  },
];
---

<PageLayout
  lang="en"
  title="Personal doTERRA Guidance | Essential Oils & Next Steps | Kyle Oils"
  description="Personal guidance on essential oils, starter kits, routines and doTERRA products. Talk through your questions with Kyle and find a clear place to begin."
>
  <HeroSplit
    title="A Personal doTERRA Consultation That Starts with You"
    primaryHref="/en/contact/"
    primaryLabel="Request a Free Consultation"
    secondaryHref={contactLinks.whatsapp.href}
    secondaryLabel="Message Me on WhatsApp"
    imageSrc="/assets/images/workshops/consultation-01.png"
    imageAlt="Calm personal essential oil consultation at a wooden table"
    imageWidth={1672}
    imageHeight={941}
    imagePosition="52% center"
    imageSources={[
      { type: 'image/avif', srcset: '/assets/images/optimized/consultation-01-640.avif 640w, /assets/images/optimized/consultation-01-960.avif 960w, /assets/images/optimized/consultation-01-1280.avif 1280w' },
      { type: 'image/webp', srcset: '/assets/images/optimized/consultation-01-640.webp 640w, /assets/images/optimized/consultation-01-960.webp 960w, /assets/images/optimized/consultation-01-1280.webp 1280w' },
    ]}
  >
    <p>Are you interested in essential oils, everyday routines or the wider doTERRA product range, but still unsure where to begin?</p>
    <p>A conversation with me is a calm first step.</p>
    <p>My consultation begins with your situation and the routines that genuinely fit your daily life. Only then do we consider whether doTERRA products or another next step could be right for you.</p>
  </HeroSplit>

  <section class="section section--cream">
    <div class="container split-layout">
      <div>
        <SectionIntro title="What We Discuss">
          <p>Essential oils and the doTERRA product range can feel overwhelming at first. Many people look for guidance around evening routines, stressful days, movement and body care, room scent, family life or choosing their first products.</p>
          <p>I explain the options clearly and without complicated jargon. Rather than a one-size-fits-all recommendation, you receive an honest assessment shaped around your daily life.</p>
        </SectionIntro>
      </div>
      <ResponsiveImage
        src="/assets/images/products/product-detail-01.png"
        alt="Essential oils on natural materials in warm light"
        width={1672}
        height={941}
        variant="portrait-wide"
        position="64% center"
        sources={[
          { type: 'image/avif', srcset: '/assets/images/optimized/product-detail-01-640.avif 640w, /assets/images/optimized/product-detail-01-960.avif 960w, /assets/images/optimized/product-detail-01-1280.avif 1280w' },
          { type: 'image/webp', srcset: '/assets/images/optimized/product-detail-01-640.webp 640w, /assets/images/optimized/product-detail-01-960.webp 960w, /assets/images/optimized/product-detail-01-1280.webp 1280w' },
        ]}
      />
    </div>
  </section>

  <section class="section section--sage">
    <div class="container">
      <SectionIntro title="How the Consultation Works" />
      <StepList steps={consultationSteps} />
    </div>
  </section>

  <section class="section section--cream">
    <div class="container split-layout split-layout--reverse">
      <ResponsiveImage
        src="/assets/images/nature/nature-detail-01.png"
        alt="Heather flowers in warm morning light"
        width={1537}
        height={1023}
        variant="portrait-wide"
        position="62% center"
      />
      <div>
        <SectionIntro title="Support Beyond Your First Step">
          <p>When you get started with doTERRA through me, you have a personal contact for product selection, use and routines alongside access to the products.</p>
          <p>With an official doTERRA customer account, you can purchase products at wholesale pricing and save 25% on your purchases. This can be helpful if you would rather not navigate the shop on your own at the beginning.</p>
        </SectionIntro>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <SectionIntro title="Possible Consultation Topics" />
      <div class="topic-grid">
        {consultationTopics.map((topic) => (
          <TopicCard title={topic.title}>
            <p>{topic.copy}</p>
          </TopicCard>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--cream local-guidance-context">
    <div class="container narrow-layout">
      <SectionIntro title="Guidance in Germany, in English">
        <p>If you live in Germany, guidance can be arranged in person, online or by phone. English guidance is also available.</p>
        <Button href="/en/essential-oil-guidance-germany/" variant="secondary">More about Essential Oil Guidance in Germany</Button>
      </SectionIntro>
    </div>
  </section>

  <section class="section">
    <div class="container faq-layout">
      <SectionIntro title="Frequently Asked Questions About Consultation" />
      <FAQAccordion items={consultationFaqs} idPrefix="consultation-faq" />
    </div>
  </section>

  <CTASection
    title="The Simplest Next Step"
    primaryHref="/en/contact/"
    primaryLabel="Request a Free Consultation"
    secondaryHref={contactLinks.whatsapp.href}
    secondaryLabel="Message Me on WhatsApp"
  >
    <p>You do not need to have chosen an oil or a kit. Simply tell me what interests you or where you would like some direction. Then we can find the next sensible step together.</p>
  </CTASection>

  <section class="compliance-section">
    <div class="container">
      <ComplianceNote label="Note">
        <p class="compliance-section__label">Note</p>
        <p>No. My support is not a substitute for medical diagnosis or treatment. I do not claim that products can diagnose, treat or cure medical conditions.</p>
      </ComplianceNote>
    </div>
  </section>
</PageLayout>

<style>
  .section { padding: var(--space-64) 0; }
  .section--cream { background: var(--color-soft-cream); }
  .section--sage { background: rgb(168 184 160 / 20%); }
  .section--nature { position: relative; isolation: isolate; background: var(--color-soft-cream); }
  .section--nature::before { content: ''; position: absolute; inset: 0; z-index: -2; background: url('/assets/images/nature/nature-heath-hero-02.png') center 54% / cover no-repeat; }
  .section--nature::after { content: ''; position: absolute; inset: 0; z-index: -1; background: rgb(250 247 241 / 76%); }
  .narrow-layout, .faq-layout { max-width: var(--container-text); }
  .split-layout { display: grid; gap: var(--space-40); align-items: center; }
  .check-list { display: grid; gap: var(--space-16); margin: 0; padding: 0; list-style: none; }
  .check-list li { position: relative; padding-left: var(--space-32); color: var(--color-text-secondary); }
  .check-list li::before { content: ''; position: absolute; left: 0; top: .72em; width: 11px; height: 11px; border-radius: 50%; background: var(--color-sage-green); }
  .trust-grid, .topic-grid { display: grid; gap: var(--space-20); }
  .local-guidance-context :global(.button) { margin-top: var(--space-24); }
  .compliance-section { padding: 0 0 var(--space-80); }
  .compliance-section__label { color: var(--color-text-primary); font-size: .7rem; font-weight: var(--font-weight-semibold); letter-spacing: .1em; text-transform: uppercase; }
  .compliance-section__label + :global(p) { margin-top: var(--space-8); }
  @media (min-width: 768px) {
    .section { padding-block: var(--space-96); }
    .trust-grid, .topic-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-24); }
  }
  @media (min-width: 1024px) {
    .section { padding-block: var(--space-120); }
    .split-layout { grid-template-columns: minmax(0, 1fr) minmax(360px, .8fr); gap: var(--space-80); }
    .split-layout--reverse { grid-template-columns: minmax(360px, .8fr) minmax(0, 1fr); }
    .trust-grid, .topic-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
