---
import ComplianceNote from '../../../components/compliance/ComplianceNote.astro';
import CTASection from '../../../components/cta/CTASection.astro';
import HeroSplit from '../../../components/sections/HeroSplit.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import '../../../styles/workshops-refined.css';

const workshopFocus = [
  'a clear foundation for essential oils and doTERRA',
  'a safety-aware first look at scent, diffusers and simple routines',
  'a useful overview of starter kits and the questions worth asking before choosing',
  'room for personal questions and realistic next steps',
];

const formats = [
  {
    title: 'Beginner Workshop',
    intro: 'For people who are new to doTERRA or want a calm overview first.',
    label: 'Suitable for:',
    items: ['small groups', 'friends and family', 'people considering a first starter kit', 'people who want to understand before deciding'],
  },
  {
    title: 'Living Room Workshop',
    intro: 'A personal, small setting at home or in a familiar environment.',
    label: 'Suitable if you:',
    items: ['do not want a big event', 'want to start with a few people', 'want to ask questions openly', 'want to experience doTERRA without pressure'],
  },
  {
    title: 'Team, Studio or Practice',
    intro: 'For small teams, studios, local businesses or practice environments that want to explore essential oils as a topic.',
    paragraphs: [
      'The focus stays on education, scent, everyday routines, safety and orientation.',
      'No medical statements are made and no applications for patients, clients or employees are promised.',
    ],
  },
];

const steps = [
  { title: '1. Short introduction to Kyle and doTERRA', paragraphs: [] },
  { title: '2. Basic understanding of essential oils', paragraphs: [] },
  { title: '3. Scent, diffuser and simple everyday routines', paragraphs: [] },
  { title: '4. Safety, dilution and sensitive situations', paragraphs: [] },
  { title: '5. Understand and compare starter kits', paragraphs: [] },
  { title: '6. Collect questions and discuss next steps', paragraphs: [] },
];

const preparationQuestions = [
  'Who will attend?',
  'Is the group new, already using oils or mixed?',
  'Should the focus be starter kits, safety, everyday routines or scent?',
  'Should the workshop be in English or German?',
  'Are children, pets or sensitive people part of the environment?',
];
---

<PageLayout lang="en" title="Essential Oil Workshops with Kyle | Kyle Oils" description="Calm doTERRA workshops with Kyle: understand essential oils, place starter kits, learn safe-use basics and clarify questions without pressure.">
  <HeroSplit
    title="doTERRA Workshops with Kyle"
    primaryHref="/en/contact/"
    primaryLabel="Request a Workshop"
    secondaryHref="/en/consultation/"
    secondaryLabel="Request Guidance"
    imageSrc="/assets/images/workshops/workshop-01.png"
    imageAlt="Small group at an essential oils workshop"
    imageWidth={1536}
    imageHeight={1024}
    imagePosition="55% center"
    imageSources={[
      { type: 'image/avif', srcset: '/assets/images/optimized/workshop-01-640.avif 640w, /assets/images/optimized/workshop-01-960.avif 960w, /assets/images/optimized/workshop-01-1280.avif 1280w' },
      { type: 'image/webp', srcset: '/assets/images/optimized/workshop-01-640.webp 640w, /assets/images/optimized/workshop-01-960.webp 960w, /assets/images/optimized/workshop-01-1280.webp 1280w' },
    ]}
  >
    <p class="hero-subtitle">Understand essential oils clearly, personally and at your own pace.</p>
    <p>The goal is to explain essential oils clearly, introduce simple routines and answer questions in a relaxed setting.</p>
    <p>You can request a workshop for yourself, a small group, friends, family or a professional environment.</p>
  </HeroSplit>

  <section class="section workshops-outcomes" aria-labelledby="workshops-outcomes-title">
    <div class="container workshops-wrap">
      <header class="workshops-heading" data-reveal>
        <p class="eyebrow">WHAT YOU WILL TAKE AWAY</p>
        <h2 id="workshops-outcomes-title">Discover, understand and use oils responsibly.</h2>
        <p>Explore essential oils together in a relaxed setting. Practical explanations, space for questions and ideas you can use in everyday life.</p>
      </header>
      <div class="workshops-outcomes__grid" data-consultation-cards>
        {workshopFocus.map((item,index)=>(<article class="workshops-outcome-card" data-consultation-card>
          <span class="workshops-number" aria-hidden="true">{String(index+1).padStart(2,"0")}</span>
          <p>{item}</p>
        </article>))}
      </div>
    </div>
  </section>

  <section class="section workshops-formats" aria-labelledby="workshops-formats-title">
    <div class="container workshops-wrap">
      <header class="workshops-heading" data-reveal>
        <p class="eyebrow">YOUR PEOPLE, YOUR FORMAT</p>
        <h2 id="workshops-formats-title">Three formats. One personal experience.</h2>
        <p>At home, with a small group or in a professional setting: we adapt the session to the people taking part.</p>
      </header>
      <div class="workshops-formats__grid" data-consultation-cards>
        {formats.map((format,index)=>(<article class="workshops-format-card" data-consultation-card>
          <div class="workshops-format-card__top"><span class="workshops-number" aria-hidden="true">{String(index+1).padStart(2,"0")}</span><span class="workshops-format-card__tag">WORKSHOP FORMAT</span></div>
          <h3>{format.title}</h3>
          <p class="workshops-format-card__intro">{format.intro}</p>
          {format.label && <h4>{format.label}</h4>}
          {format.items && <ul>{format.items.map(item=><li>{item}</li>)}</ul>}
          {format.paragraphs && <div class="workshops-format-card__details">{format.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div>}
        </article>))}
      </div>
    </div>
  </section>

  <section class="section workshops-process" aria-labelledby="workshops-process-title">
    <div class="container workshops-wrap">
      <header class="workshops-heading" data-reveal>
        <p class="eyebrow">WHAT TO EXPECT</p>
        <h2 id="workshops-process-title">From first impressions to everyday routines.</h2>
        <p>Six simple steps guide the session. We can agree on the topics that matter most to your group beforehand.</p>
      </header>
      <ol class="workshops-process__grid" data-consultation-cards>
        {steps.map((step,index)=>(<li class="workshops-process-card" data-consultation-card>
          <span class="workshops-process-card__number" aria-hidden="true">{String(index+1).padStart(2,"0")}</span>
          <h3>{step.title.replace(/^\d+\.\s*/, "")}</h3>
        </li>))}
      </ol>
      <p class="workshops-process__note">The sequence and focus can be tailored to your group.</p>
    </div>
  </section>

  <section class="section workshops-preparation" aria-labelledby="workshops-preparation-title">
    <div class="container workshops-wrap workshops-preparation__grid" data-reveal>
      <div class="workshops-preparation__copy">
        <p class="eyebrow">GETTING READY</p>
        <h2 id="workshops-preparation-title">A few questions and we can get started.</h2>
        <p>You do not need a detailed plan. These five answers help me shape a workshop that feels right for your group.</p>
        <p class="workshops-preparation__foot">English or German, private or professional: we can work out what suits you together.</p>
      </div>
      <div class="workshops-preparation__questions">
        <ol>{preparationQuestions.map((q,index)=>(<li>
          <span class="workshops-number" aria-hidden="true">{String(index+1).padStart(2,"0")}</span>
          <span>{q}</span>
        </li>))}</ol>
      </div>
    </div>
  </section>

  <CTASection title="Ready to plan a workshop?" primaryHref="/en/contact/" primaryLabel="Request a Workshop" secondaryHref="/en/consultation/" secondaryLabel="Personal Guidance">
    <p>Tell me roughly how many people are interested and what you would like to explore. I can help you find the right format, focus and date.</p>
  </CTASection>
  <section class="compliance-section workshops-compliance">
    <div class="container"><ComplianceNote label="IMPORTANT NOTE">
      <p class="workshops-compliance__label">IMPORTANT NOTE</p>
      <p>Workshops provide educational information about essential oils, products, routines and responsible use. They do not replace medical advice, diagnosis or treatment, and no medical or healing claims are made.</p>
    </ComplianceNote></div>
  </section>
  <script is:inline src="/scripts/consultation-motion.js" defer></script>
</PageLayout>
