---
import ComplianceNote from '../../../components/compliance/ComplianceNote.astro';
import TopicCard from '../../../components/cards/TopicCard.astro';
import CTASection from '../../../components/cta/CTASection.astro';
import HeroSplit from '../../../components/sections/HeroSplit.astro';
import SectionIntro from '../../../components/sections/SectionIntro.astro';
import StepList from '../../../components/sections/StepList.astro';
import PageLayout from '../../../layouts/PageLayout.astro';

const workshopFocus = [
  'what essential oils are and how concentrated they are',
  'how doTERRA basically works',
  'which starter kits exist and who they may fit',
  'how to start calmly with diffuser, scent and simple routines',
  'what matters around dilution, skin contact and sensitive people',
  'which questions are useful before ordering',
  'what personal support after the purchase can look like',
];

const formats = [
  {
    title: 'Beginner Workshop',
    intro: 'For people who are new to doTERRA or want a calm overview first.',
    label: 'Suitable for:',
    items: ['small groups', 'friends and family', 'people considering a first starter kit', 'people who want to understand before deciding'],
  },
  {
    title: 'Living Room Workshop',
    intro: 'A personal, small setting at home or in a familiar environment.',
    label: 'Suitable if you:',
    items: ['do not want a big event', 'want to start with a few people', 'want to ask questions openly', 'want to experience doTERRA without pressure'],
  },
  {
    title: 'Team, Studio or Practice',
    intro: 'For small teams, studios, local businesses or practice environments that want to explore essential oils as a topic.',
    paragraphs: [
      'The focus stays on education, scent, everyday routines, safety and orientation.',
      'No medical statements are made and no applications for patients, clients or employees are promised.',
    ],
  },
];

const steps = [
  { title: '1. Short introduction to Kyle and doTERRA', paragraphs: [] },
  { title: '2. Basic understanding of essential oils', paragraphs: [] },
  { title: '3. Scent, diffuser and simple everyday routines', paragraphs: [] },
  { title: '4. Safety, dilution and sensitive situations', paragraphs: [] },
  { title: '5. Calm placement of starter kits', paragraphs: [] },
  { title: '6. Collect questions and clarify next steps', paragraphs: [] },
];

const expectations = [
  'a calm introduction',
  'clear language without technical overload',
  'realistic orientation',
  'no healing promises',
  'no pressure situation',
  'room for questions',
  'orientation for everyday life',
];

const notIncluded = [
  'medical guidance',
  'therapy',
  'diagnosis',
  'a treatment promise',
  'an obligation to buy',
  'an obligation to open a customer account',
  'a business event unless this is clearly requested',
];

const preparationQuestions = [
  'Who will attend?',
  'Is the group new, already using oils or mixed?',
  'Should the focus be starter kits, safety, everyday routines or scent?',
  'Should the workshop be in English or German?',
  'Are children, pets or sensitive people part of the environment?',
];
---

<PageLayout lang="en" title="doTERRA Workshops | Kyle Oils" description="Calm doTERRA workshops with Kyle: understand essential oils, place starter kits, learn safe-use basics and clarify questions without pressure.">
  <HeroSplit
    title="doTERRA Workshops with Kyle"
    primaryHref="/en/contact/"
    primaryLabel="Request a Workshop"
    secondaryHref="/en/consultation/"
    secondaryLabel="Request Guidance"
    imageSrc="/assets/images/workshops/workshop-01.png"
    imageAlt="Small group at an essential oils workshop"
    imageWidth={1536}
    imageHeight={1024}
    imagePosition="55% center"
  >
    <p class="hero-subtitle">Understand essential oils calmly, personally and without a sales event.</p>
    <p>A Kyle Oils workshop is not a loud sales evening and not a medical lecture.</p>
    <p>The goal is to place essential oils clearly, introduce simple routines and clarify questions in a calm setting.</p>
    <p>You can request a workshop for yourself, a small group, friends, family or a professional environment.</p>
  </HeroSplit>

  <section class="section section--cream">
    <div class="container narrow-layout">
      <SectionIntro title="What a workshop should do">
        <p>A workshop helps you and your group understand doTERRA more clearly.</p>
        <p>The focus is on:</p>
      </SectionIntro>
      <ul class="check-list">{workshopFocus.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionIntro title="Workshop formats" />
      <div class="format-grid">
        {formats.map((format) => (
          <TopicCard title={format.title}>
            <p>{format.intro}</p>
            {format.label && <h4>{format.label}</h4>}
            {format.items && <ul>{format.items.map((item) => <li>{item}</li>)}</ul>}
            {format.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          </TopicCard>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--sage">
    <div class="container narrow-layout">
      <SectionIntro title="How it works">
        <p>A workshop can be shaped differently depending on the group.</p>
        <p>A typical flow:</p>
      </SectionIntro>
      <StepList steps={steps} />
      <p class="section-copy">The flow can be discussed beforehand.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow-layout">
      <SectionIntro title="What participants can expect">
        <p>Participants receive:</p>
      </SectionIntro>
      <ul class="check-list">{expectations.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container split-layout">
      <div>
        <SectionIntro title="What a workshop is not">
          <p>A workshop is not:</p>
        </SectionIntro>
        <ul class="check-list">{notIncluded.map((item) => <li>{item}</li>)}</ul>
      </div>
      <aside class="calm-panel">
        <h2>No pressure</h2>
        <p>The workshop is for orientation. Decisions about products or a customer account remain voluntary at all times.</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container narrow-layout">
      <SectionIntro title="Preparation">
        <p>A few simple questions help create a good workshop:</p>
      </SectionIntro>
      <ul class="check-list">{preparationQuestions.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <CTASection title="Request a workshop" primaryHref="/en/contact/" primaryLabel="Request a Workshop" secondaryHref="/en/consultation/" secondaryLabel="Request Guidance">
    <p>If you would like to request a workshop with Kyle, send a short message about who the workshop is for and which setting would fit.</p>
    <p>Kyle will reply with a calm recommendation on whether and how a workshop makes sense.</p>
  </CTASection>

  <section class="compliance-section">
    <div class="container">
      <ComplianceNote label="Note">
        <h2>Note</h2>
        <p>Kyle Oils does not replace medical guidance and does not make healing promises. Workshops help people understand doTERRA products, routines and safety questions more clearly.</p>
      </ComplianceNote>
    </div>
  </section>
</PageLayout>

<style>
  .section { padding: var(--space-64) 0; }
  .section--cream { background: var(--color-soft-cream); }
  .section--sage { background: rgb(168 184 160 / 20%); }
  .narrow-layout { max-width: var(--container-text); }
  .hero-subtitle { color: var(--color-deep-forest); font-size: var(--font-size-h3-mobile); font-weight: var(--font-weight-semibold); }
  .check-list { display: grid; gap: var(--space-16); margin: 0; padding: 0; list-style: none; }
  .check-list li { position: relative; padding-left: var(--space-32); color: var(--color-text-secondary); }
  .check-list li::before { content: ''; position: absolute; top: .72em; left: 0; width: 11px; height: 11px; border-radius: 50%; background: var(--color-sage-green); }
  .format-grid, .split-layout { display: grid; gap: var(--space-24); }
  .format-grid :global(.topic-card h4) { margin: var(--space-20) 0 var(--space-12); font-size: var(--font-size-body-mobile); }
  .format-grid :global(.topic-card ul) { display: grid; gap: var(--space-12); margin: 0; padding-left: var(--space-24); }
  .format-grid :global(.topic-card p + p) { margin-top: var(--space-16); }
  .section-copy { margin: var(--space-32) 0 0; color: var(--color-text-secondary); }
  .calm-panel { align-self: start; padding: var(--space-32); border-radius: var(--radius-section); background: var(--color-warm-white); box-shadow: var(--shadow-card); }
  .calm-panel h2 { margin: 0 0 var(--space-16); font-size: var(--font-size-h3-mobile); line-height: 1.2; }
  .calm-panel p { margin: 0; color: var(--color-text-secondary); }
  .compliance-section { padding: 0 0 var(--space-80); }
  .compliance-section :global(h2) { margin: 0 0 var(--space-12); font-size: var(--font-size-body-mobile); }
  @media (min-width: 768px) { .section { padding-block: var(--space-96); } .format-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .section { padding-block: var(--space-120); } .format-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .split-layout { grid-template-columns: minmax(0, 1fr) minmax(320px, .72fr); gap: var(--space-80); } .hero-subtitle { font-size: var(--font-size-h3-desktop); } }
</style>
