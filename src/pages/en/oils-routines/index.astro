---
import ComplianceNote from '../../../components/compliance/ComplianceNote.astro';
import TopicCard from '../../../components/cards/TopicCard.astro';
import CTASection from '../../../components/cta/CTASection.astro';
import ResponsiveImage from '../../../components/global/ResponsiveImage.astro';
import HeroSplit from '../../../components/sections/HeroSplit.astro';
import SectionIntro from '../../../components/sections/SectionIntro.astro';
import PageLayout from '../../../layouts/PageLayout.astro';

const applicationMethods = [
  { title: 'Aromatic use', copy: 'Through scent, for example in a diffuser, from an opened bottle or as a considered scent moment.' },
  { title: 'Topical use', copy: 'On the skin, for example diluted with a suitable carrier oil or as part of a massage and care routine.' },
  { title: 'Internal use', copy: 'Only for products explicitly labelled for that purpose, and only in line with their instructions for use.' },
];

const intentPaths = [
  { title: 'Stressful days & inner orientation', copy: 'Scent anchors and small pauses for days that ask a lot of you.', href: '/en/knowledge/products-systems/adaptiv-stressful-days-scent-anchors/' },
  { title: 'Evening & sleep routine', copy: 'A pleasant evening setting and considered rituals around bedtime.', href: '/en/knowledge/products-systems/serenity-evening-sleep-routine-safe-context/' },
  { title: 'Movement, massage & body care', copy: 'Care, massage and routines after active days.', href: '/en/knowledge/products-systems/deep-blue-movement-massage-body-comfort/' },
  { title: 'Digestive feel & food routines', copy: 'Product and routine knowledge around meals, travel and considered habits.', href: '/en/knowledge/products-systems/zengest-digestive-feel-food-routines/' },
  { title: 'Family & safe use', copy: 'Safety knowledge for households where quantity, room size and consideration matter.', href: '/en/knowledge/safe-use/' },
  { title: 'Home & everyday routines', copy: 'Room scent, household moments and small habits that fit your home.', href: '/en/knowledge/everyday-use/' },
];
---

<PageLayout lang="en" title="Essential Oils for Everyday Life | Uses & Routines | Kyle Oils" description="Place essential oils in everyday life: aromatic, topical and label-aware use, plus routines that fit your day.">
  <HeroSplit title="Essential Oils for Everyday Life" primaryHref="/en/knowledge/" primaryLabel="Explore the Knowledge Hub" secondaryHref="/en/contact/" secondaryLabel="Talk with Kyle" imageSrc="/assets/images/products/essential-oils-display.jpg" imageAlt="Essential oils arranged in a wooden holder" imageWidth={2400} imageHeight={3600} imagePosition="54% center" imageSources={[{ type: 'image/avif', srcset: '/assets/images/optimized/essential-oils-display-640.avif 640w, /assets/images/optimized/essential-oils-display-960.avif 960w, /assets/images/optimized/essential-oils-display-1280.avif 1280w' }, { type: 'image/webp', srcset: '/assets/images/optimized/essential-oils-display-640.webp 640w, /assets/images/optimized/essential-oils-display-960.webp 960w, /assets/images/optimized/essential-oils-display-1280.webp 1280w' }]}>
    <p>Essential oils become most useful when they earn a real place in your routines.</p>
    <p>Explore use and interests first. Products can follow when they genuinely fit.</p>
  </HeroSplit>

  <section class="section"><div class="container"><SectionIntro title="Three ways to use essential oils"><p>Depending on the product, essential oils can be used through scent, on the skin or internally where a label supports it.</p></SectionIntro><div class="application-grid">{applicationMethods.map((method) => <TopicCard title={method.title}><p>{method.copy}</p></TopicCard>)}</div><p class="safety-note">Not every oil suits every use. Always follow the label and product packaging. Professional advice matters if you are unsure, pregnant, breastfeeding, considering use around children or managing health questions.</p></div></section>

  <section class="section section--sage"><div class="container"><SectionIntro title="Where would you like to start?"><p>Choose the topic that feels relevant today. From there, the Knowledge Hub can take you deeper.</p></SectionIntro><div class="intent-grid">{intentPaths.map((path) => <a class="intent-card" href={path.href}><h2>{path.title}</h2><p>{path.copy}</p><span aria-hidden="true">Explore <span aria-hidden="true">→</span></span></a>)}</div></div></section>

  <section class="section section--cream"><div class="container split-layout"><div><SectionIntro title="A routine you will actually keep"><p>A useful beginning does not need to be large. A scent moment in the morning, massage after movement or a considered room can be enough.</p><p>Choose one moment, one kind of use and one small habit that is easy to repeat. This is how curiosity becomes practical experience.</p></SectionIntro></div><ResponsiveImage src="/assets/images/products/diffuser-lemon.jpg" alt="A diffuser and essential lemon oil in a bright setting" width={3600} height={2400} variant="portrait-wide" position="58% center" sources={[{ type: 'image/avif', srcset: '/assets/images/optimized/diffuser-lemon-640.avif 640w, /assets/images/optimized/diffuser-lemon-960.avif 960w, /assets/images/optimized/diffuser-lemon-1280.avif 1280w' }, { type: 'image/webp', srcset: '/assets/images/optimized/diffuser-lemon-640.webp 640w, /assets/images/optimized/diffuser-lemon-960.webp 960w, /assets/images/optimized/diffuser-lemon-1280.webp 1280w' }]}/></div></section>

  <section class="section knowledge-continuation"><div class="container narrow-layout"><SectionIntro title="Keep learning in the Knowledge Hub"><p>Find oil profiles, safe-use guidance, routines and product knowledge in one place. Explore further before you choose anything.</p></SectionIntro><a class="knowledge-continuation__link" href="/en/knowledge/">Go to the Knowledge Hub <span aria-hidden="true">→</span></a></div></section>

  <CTASection title="Questions about your next step?" primaryHref="/en/contact/" primaryLabel="Talk with Kyle"><p>If you would like to place a topic more clearly, Kyle can help you find a sensible next step.</p></CTASection>
  <section class="compliance-section"><div class="container"><ComplianceNote label="A brief note"><h2>A brief note</h2><p>Guidance does not replace medical diagnosis or treatment. Essential oils and wellness products can be part of considered routines, but not a substitute for medical care.</p></ComplianceNote></div></section>
</PageLayout>

<style>
  .section { padding: var(--space-64) 0; } .section--cream { background: var(--color-soft-cream); } .section--sage { background: rgb(168 184 160 / 20%); } .narrow-layout { max-width: var(--container-text); } .application-grid, .intent-grid, .split-layout { display: grid; gap: var(--space-20); }
  .safety-note { max-width: var(--container-text); margin: var(--space-32) 0 0; padding: var(--space-24); border: 1px solid rgb(216 199 173 / 70%); border-radius: var(--radius-card); background: var(--color-soft-cream); color: var(--color-text-secondary); }
  .intent-card { display: grid; gap: var(--space-12); min-height: 190px; padding: var(--space-24); border: 1px solid rgb(216 199 173 / 70%); border-radius: var(--radius-card); background: var(--color-warm-white); box-shadow: var(--shadow-card); color: var(--color-text-primary); text-decoration: none; }
  .intent-card h2, .intent-card p { margin: 0; } .intent-card h2 { font-size: var(--font-size-h3-mobile); line-height: 1.2; } .intent-card p { color: var(--color-text-secondary); } .intent-card span { align-self: end; margin-top: auto; color: var(--color-deep-forest); font-size: var(--font-size-small); font-weight: var(--font-weight-semibold); } .intent-card:hover, .intent-card:focus-visible { border-color: var(--color-sage-green); }
  .knowledge-continuation { background: var(--color-warm-white); } .knowledge-continuation__link { display: inline-flex; align-items: center; gap: var(--space-8); min-height: 48px; color: var(--color-deep-forest); font-weight: var(--font-weight-semibold); text-decoration: none; } .knowledge-continuation__link:hover, .knowledge-continuation__link:focus-visible { text-decoration: underline; }
  .compliance-section { padding: 0 0 var(--space-80); } .compliance-section :global(h2) { margin: 0 0 var(--space-12); font-size: var(--font-size-body-mobile); }
  @media (min-width: 768px) { .section { padding-block: var(--space-96); } .application-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .intent-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-24); } }
  @media (min-width: 1024px) { .section { padding-block: var(--space-120); } .intent-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .split-layout { grid-template-columns: minmax(0, 1fr) minmax(360px, .82fr); gap: var(--space-80); align-items: center; } }
</style>
