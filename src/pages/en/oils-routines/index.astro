---
import ComplianceNote from '../../../components/compliance/ComplianceNote.astro';
import CTASection from '../../../components/cta/CTASection.astro';
import ResponsiveImage from '../../../components/global/ResponsiveImage.astro';
import HeroSplit from '../../../components/sections/HeroSplit.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import '../../../styles/oils-routines-refined.css';

const applicationMethods = [
  { title: 'Aromatic use', copy: 'Through scent, for example in a diffuser, from an opened bottle or as a considered scent moment.' },
  { title: 'Topical use', copy: 'On the skin, for example diluted with a suitable carrier oil or as part of a massage and care routine.' },
  { title: 'Internal use', copy: 'Only for products explicitly labelled for that purpose, and only in line with their instructions for use.' },
];

const intentPaths = [
  { title: 'Busy Days & Small Pauses', copy: 'Scent anchors and small pauses for days that ask a lot of you.', href: '/en/knowledge/products-systems/adaptiv-stressful-days-scent-anchors/' },
  { title: 'Evening & sleep routine', copy: 'A pleasant evening setting and considered rituals around bedtime.', href: '/en/knowledge/products-systems/serenity-evening-sleep-routine-safe-context/' },
  { title: 'Movement, massage & body care', copy: 'Care, massage and routines after active days.', href: '/en/knowledge/products-systems/deep-blue-movement-massage-body-comfort/' },
  { title: 'Meals, Travel & Everyday Habits', copy: 'Product and routine knowledge around meals, travel and considered habits.', href: '/en/knowledge/products-systems/zengest-digestive-feel-food-routines/' },
  { title: 'Family & safe use', copy: 'Safety knowledge for households where quantity, room size and consideration matter.', href: '/en/knowledge/safe-use/' },
  { title: 'Home & everyday routines', copy: 'Room scent, household moments and small habits that fit your home.', href: '/en/knowledge/everyday-use/' },
];
---

<PageLayout lang="en" title="Essential Oils for Everyday Life | Uses & Routines | Kyle Oils" description="Place essential oils in everyday life: aromatic, topical and label-aware use, plus routines that fit your day.">
  <HeroSplit title="Essential Oils for Everyday Life" primaryHref="/en/knowledge/" primaryLabel="Explore the Knowledge Hub" secondaryHref="/en/contact/" secondaryLabel="Talk with Kyle" imageSrc="/assets/images/products/essential-oils-display.jpg" imageAlt="Essential oils arranged in a wooden holder" imageWidth={2400} imageHeight={3600} imagePosition="54% center" imageSources={[{ type: 'image/avif', srcset: '/assets/images/optimized/essential-oils-display-640.avif 640w, /assets/images/optimized/essential-oils-display-960.avif 960w, /assets/images/optimized/essential-oils-display-1280.avif 1280w' }, { type: 'image/webp', srcset: '/assets/images/optimized/essential-oils-display-640.webp 640w, /assets/images/optimized/essential-oils-display-960.webp 960w, /assets/images/optimized/essential-oils-display-1280.webp 1280w' }]}>
    <p>Essential oils become most useful when they earn a real place in your routines.</p>
    <p>Explore use and interests first. Products can follow when they genuinely fit.</p>
  </HeroSplit>

  <section class="section oils-methods" aria-labelledby="oils-methods-title">
    <div class="container oils-layout" data-reveal>
      <header class="oils-section-heading">
        <p class="eyebrow">UNDERSTANDING USE</p>
        <h2 id="oils-methods-title">Three ways to explore essential oils.</h2>
        <p>Scent, skincare and – only where expressly supported by a product label – internal use. What matters is the guidance for each individual product.</p>
      </header>
      <div class="oils-methods__grid" data-consultation-cards>
        {applicationMethods.map((method, index) => (
          <article class="oils-method-card" data-consultation-card>
            <span class="oils-card-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{method.title}</h3>
            <p>{method.copy}</p>
          </article>
        ))}
      </div>
      <aside class="oils-safety-note" aria-label="USE WITH CARE">
        <span class="oils-safety-note__title">USE WITH CARE</span>
        <p>Not every oil suits every use. Always follow the label and product packaging. Seek professional advice if you are unsure, pregnant, breastfeeding, considering use around children or managing health questions.</p>
      </aside>
    </div>
  </section>

  <section class="section oils-interests" aria-labelledby="oils-interests-title">
    <div class="container oils-layout">
      <header class="oils-section-heading" data-reveal>
        <p class="eyebrow">WHAT FITS YOUR EVERYDAY LIFE?</p>
        <h2 id="oils-interests-title">Simple moments. Many possibilities.</h2>
        <p>You do not need to try everything at once. Start with an area that genuinely feels relevant to you.</p>
      </header>
      <div class="oils-interests__grid" data-consultation-cards>
        {intentPaths.map((path, index) => (
          <a class="oils-interest-card" href={path.href} data-consultation-card>
            <span class="oils-card-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{path.title}</h3>
            <p>{path.copy}</p>
            <span class="oils-interest-card__more">Explore this topic <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section oils-routine" aria-labelledby="oils-routine-title">
    <div class="container oils-routine__grid" data-reveal>
      <div class="oils-routine__text">
        <p class="eyebrow">KEEP IT SIMPLE</p>
        <h2 id="oils-routine-title">A routine you will actually keep.</h2>
        <p>A useful beginning does not need to be elaborate. A scent moment in the morning, massage after movement or an intentionally scented room can be enough.</p>
        <p>Choose one moment, one safe way to use a product and one small habit you can repeat easily. This is how curiosity becomes something practical in your day.</p>
        <p class="oils-routine__detail">One moment · one use · one small beginning</p>
      </div>
      <ResponsiveImage
        src="/assets/images/products/diffuser-lemon.jpg"
        alt="A diffuser and essential lemon oil in a bright setting"
        width={3600}
        height={2400}
        variant="portrait-wide"
        position="58% center"
        treatment="hero"
        sources={[
          { type: 'image/avif', srcset: '/assets/images/optimized/diffuser-lemon-640.avif 640w, /assets/images/optimized/diffuser-lemon-960.avif 960w, /assets/images/optimized/diffuser-lemon-1280.avif 1280w' },
          { type: 'image/webp', srcset: '/assets/images/optimized/diffuser-lemon-640.webp 640w, /assets/images/optimized/diffuser-lemon-960.webp 960w, /assets/images/optimized/diffuser-lemon-1280.webp 1280w' },
        ]}
      />
    </div>
  </section>

  <section class="section oils-learning" aria-labelledby="oils-learning-title">
    <div class="container oils-learning__inner" data-reveal>
      <div>
        <p class="eyebrow">LEARN AT YOUR OWN PACE</p>
        <h2 id="oils-learning-title">Curious about what comes next?</h2>
        <p>The Knowledge Hub brings together clear oil profiles, responsible-use guidance and simple everyday routines. Take your time to learn, compare and decide what you want to explore.</p>
        <p class="oils-learning__note">Understanding first. Products follow when they make sense for you.</p>
      </div>
      <div class="oils-learning__actions">
        <a class="oils-learning__primary" href="/en/knowledge/">Explore the Knowledge Hub</a>
        <a class="oils-learning__secondary" href="/en/knowledge/safe-use/">Safe use essentials <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <CTASection
    title="Questions about getting started?"
    primaryHref="/en/contact/"
    primaryLabel="Ask for guidance"
    secondaryHref="/en/knowledge/"
    secondaryLabel="Explore the Knowledge Hub"
  >
    <p>You do not need to have chosen an oil or a kit. Tell me what interests you and we can find a sensible next step together.</p>
  </CTASection>

  <section class="compliance-section oils-compliance">
    <div class="container">
      <ComplianceNote label="A brief note">
        <p class="oils-compliance__label">A brief note</p>
        <p>My guidance is not a substitute for medical diagnosis or treatment. Essential oils and wellness products may be part of mindful routines but do not replace medical care.</p>
      </ComplianceNote>
    </div>
  </section>
  <script is:inline src="/scripts/consultation-motion.js" defer></script>
</PageLayout>
