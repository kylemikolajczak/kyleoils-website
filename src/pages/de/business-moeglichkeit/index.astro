---
import ComplianceNote from '../../../components/compliance/ComplianceNote.astro';
import CTASection from '../../../components/cta/CTASection.astro';
import HeroSplit from '../../../components/sections/HeroSplit.astro';
import SectionIntro from '../../../components/sections/SectionIntro.astro';
import StepList from '../../../components/sections/StepList.astro';
import PageLayout from '../../../layouts/PageLayout.astro';

const responsiblePractice = [
  'Produkte erst selbst verstehen',
  'ehrlich beraten und Fragen beantworten',
  'Sicherheit und Alltag verständlich einordnen',
  'Menschen nach dem Kauf respektvoll begleiten',
  'nur bei echtem Interesse über eine Business-Rolle sprechen',
];

const couldFit = [
  'doTERRA Produkte wirklich magst und gern weitergibst',
  'Menschen ehrlich begleiten möchtest',
  'bereit bist zu lernen und Fragen zu stellen',
  'langfristig denkst und einen verantwortungsvollen Aufbau schätzt',
  'Produkte und Kunden verstehen möchtest, bevor du über Teamaufbau nachdenkst',
];

const customerFirstSteps = [
  { title: '1. doTERRA kennenlernen', paragraphs: [] },
  { title: '2. Produkte und Starter-Sets verstehen', paragraphs: [] },
  { title: '3. Eigene Routinen finden', paragraphs: [] },
  { title: '4. Erfahrung sammeln und Fragen klären', paragraphs: [] },
  { title: '5. Erst dann eine mögliche Business-Rolle betrachten', paragraphs: [] },
];

const conversationQuestions = [
  'Warum interessiert dich die Business-Möglichkeit?',
  'Welche Produkte und Erfahrungen möchtest du wirklich teilen?',
  'Wie viel Zeit und Energie hast du realistisch?',
  'Passt dir ein langsamer, seriöser Aufbau?',
  'Welche Erwartungen sollten von Anfang an klar eingeordnet werden?',
];
---

<PageLayout lang="de" title="doTERRA Business-Möglichkeit | Kyle Oils" description="Eine ehrliche Orientierung zur doTERRA Business-Möglichkeit: Produkte zuerst verstehen, Menschen verantwortungsvoll begleiten und Erwartungen realistisch einordnen.">
  <HeroSplit title="Die doTERRA Business-Möglichkeit" primaryHref="/de/kontakt/" primaryLabel="Business-Möglichkeit besprechen" secondaryHref="/de/beratung/" secondaryLabel="Erst Beratung anfragen" imageSrc="/assets/images/business/business-kyle-hero.jpg" imageAlt="Kyle in einer ruhigen Arbeitsumgebung" imageWidth={1023} imageHeight={1537} imagePosition="66% center">
    <p class="core-message">Aus Begeisterung kann etwas Eigenes entstehen.</p>
    <p>Nicht jeder, der doTERRA nutzt, möchte daraus ein Business machen. Und das ist völlig in Ordnung.</p>
    <p>Produkte verstehen, ehrlich begleiten und Kunden respektvoll unterstützen stehen immer vor einer möglichen Business-Rolle.</p>
  </HeroSplit>

  <section class="section section--cream"><div class="container narrow-layout"><SectionIntro title="Was doTERRA Business bedeuten kann"><p>doTERRA arbeitet mit selbstständigen Beraterinnen und Beratern, die Produkte erklären, Kunden begleiten und Menschen beim Einstieg unterstützen können.</p><p>Bei Kyle beginnt das mit Verantwortung: verständliche Informationen, aufmerksame Begleitung und ein ehrlicher Blick darauf, ob dieser Weg überhaupt passt.</p></SectionIntro><ul class="check-list">{responsiblePractice.map((item) => <li>{item}</li>)}</ul></div></section>

  <section class="section section--sage"><div class="container narrow-layout"><SectionIntro title="Wenn dieser Weg zu dir passen kann"><p>Die Business-Möglichkeit kann interessant sein, wenn du:</p></SectionIntro><ul class="check-list">{couldFit.map((item) => <li>{item}</li>)}</ul><p class="section-closing">Es geht nicht um schnelle Ergebnisse. Ein kundennaher, verantwortungsvoller Aufbau braucht Zeit, Lernen und echtes Interesse an den Produkten.</p></div></section>

  <section class="section section--cream"><div class="container"><SectionIntro title="Erst Kunde, dann vielleicht Partner"><p>Der sinnvollere Weg führt zuerst über eigene Erfahrung und ein gutes Produktverständnis.</p></SectionIntro><div class="step-grid"><StepList steps={customerFirstSteps} /></div></div></section>

  <section class="section"><div class="container split-copy"><SectionIntro title="Was Kyle in einem Business-Gespräch klärt"><p>Ein Gespräch hilft, Möglichkeiten und Erwartungen in eine realistische Reihenfolge zu bringen.</p></SectionIntro><ul class="check-list">{conversationQuestions.map((item) => <li>{item}</li>)}</ul></div></section>

  <CTASection title="Business-Möglichkeit besprechen" primaryHref="/de/kontakt/" primaryLabel="Business-Möglichkeit besprechen" secondaryHref="/de/beratung/" secondaryLabel="Erst Beratung anfragen"><p>Wenn du doTERRA bereits interessant findest und wissen möchtest, ob die Business-Möglichkeit zu dir passen könnte, kannst du Kyle eine unverbindliche Nachricht schicken.</p><p>Der Fokus bleibt ehrlich und realistisch.</p></CTASection>

  <section class="compliance-section"><div class="container"><ComplianceNote><h2>Hinweis</h2><p>Kyle Oils ersetzt keine rechtliche, steuerliche oder finanzielle Beratung und gibt keine Einkommensversprechen. Inhalte zur doTERRA Business-Möglichkeit dienen der allgemeinen Orientierung und sollten immer mit aktuellen offiziellen doTERRA Informationen abgeglichen werden.</p></ComplianceNote></div></section>
</PageLayout>

<style>
  :global(.hero .responsive-image img) { transform: scale(1.06); }
  :global(.hero .core-message) { color: var(--color-deep-forest); font-size: var(--font-size-h3-mobile); font-weight: 600; }
  .section { padding: var(--space-64) 0; }
  .section--cream { background: var(--color-soft-cream); }
  .section--sage { background: rgb(168 184 160 / 20%); }
  .narrow-layout { max-width: var(--container-text); }
  .split-copy { display: grid; gap: var(--space-24); }
  .check-list { display: grid; gap: var(--space-16); margin: 0; padding: 0; list-style: none; }
  .check-list li { position: relative; padding-left: var(--space-32); color: var(--color-text-secondary); }
  .check-list li::before { content: ''; position: absolute; top: .72em; left: 0; width: 11px; height: 11px; border-radius: 50%; background: var(--color-sage-green); }
  .section-closing { max-width: var(--container-text); margin: var(--space-32) 0 0; color: var(--color-text-secondary); }
  .step-grid :global(.step-list) { grid-template-columns: minmax(0, 1fr); }
  .compliance-section { padding: 0 0 var(--space-80); }
  .compliance-section :global(h2) { margin: 0 0 var(--space-12); font-size: var(--font-size-body-mobile); }
  @media (min-width: 768px) { .section { padding-block: var(--space-96); } .step-grid :global(.step-list) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .section { padding-block: var(--space-120); } .split-copy { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-64); } :global(.hero .core-message) { font-size: var(--font-size-h3-desktop); } }
</style>
