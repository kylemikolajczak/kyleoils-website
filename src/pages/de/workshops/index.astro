---
import ComplianceNote from '../../../components/compliance/ComplianceNote.astro';
import CTASection from '../../../components/cta/CTASection.astro';
import HeroSplit from '../../../components/sections/HeroSplit.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import '../../../styles/workshops-refined.css';

const workshopFocus = [
  'ein klares Grundverständnis für ätherische Öle und doTERRA',
  'eine sichere erste Einordnung von Duft, Diffuser und einfachen Routinen',
  'einen Überblick über Starter-Sets und sinnvolle Fragen vor einer Entscheidung',
  'Raum für eigene Fragen und realistische nächste Schritte',
];

const formats = [
  {
    title: 'Einsteiger-Workshop',
    intro: 'Für Menschen, die doTERRA noch nicht kennen oder erst einen ruhigen Überblick brauchen.',
    label: 'Gut geeignet für:',
    items: ['kleine Gruppen', 'Freunde und Familie', 'Interessenten vor dem ersten Starter-Set', 'Menschen, die erst verstehen möchten, bevor sie entscheiden'],
  },
  {
    title: 'Wohnzimmer-Workshop',
    intro: 'Ein persönlicher, kleiner Rahmen zu Hause oder in vertrauter Umgebung.',
    label: 'Gut geeignet, wenn du:',
    items: ['keine große Veranstaltung möchtest', 'mit wenigen Menschen starten willst', 'Fragen offen stellen möchtest', 'doTERRA ohne Druck erleben möchtest'],
  },
  {
    title: 'Team, Studio oder Praxis',
    intro: 'Für kleine Teams, Studios, lokale Unternehmen oder Praxisumfelder, die ätherische Öle als Thema kennenlernen möchten.',
    paragraphs: [
      'Der Fokus bleibt auf Bildung, Duft, Alltag, Sicherheit und Orientierung.',
      'Es werden keine medizinischen Aussagen gemacht und keine Anwendungen für Patienten, Kunden oder Mitarbeitende versprochen.',
    ],
  },
];

const steps = [
  { title: '1. Kurze Vorstellung von Kyle und doTERRA', paragraphs: [] },
  { title: '2. Grundverständnis ätherischer Öle', paragraphs: [] },
  { title: '3. Duft, Diffuser und einfache Alltagsroutinen', paragraphs: [] },
  { title: '4. Sicherheit, Verdünnung und sensible Situationen', paragraphs: [] },
  { title: '5. Starter-Sets verstehen und vergleichen', paragraphs: [] },
  { title: '6. Fragen sammeln und nächste Schritte klären', paragraphs: [] },
];

const preparationQuestions = [
  'Wer nimmt teil?',
  'Geht es um Einsteiger, Kunden oder eine gemischte Gruppe?',
  'Soll es um Starter-Sets, Sicherheit, Alltag oder Duft gehen?',
  'Soll der Workshop auf Deutsch oder Englisch stattfinden?',
  'Gibt es Kinder, Haustiere oder sensible Personen im Umfeld?',
];
---

<PageLayout title="doTERRA Workshops in Lüneburg | Kyle Oils" description="Ruhige doTERRA Workshops mit Kyle: ätherische Öle verstehen, Starter-Sets einordnen, sichere Grundlagen kennenlernen und Fragen ohne Druck klären.">
  <HeroSplit
    title="doTERRA Workshops mit Kyle"
    primaryHref="/de/kontakt/"
    primaryLabel="Workshop anfragen"
    secondaryHref="/de/beratung/"
    secondaryLabel="Beratung anfragen"
    imageSrc="/assets/images/workshops/workshop-01.png"
    imageAlt="Kleine Gruppe bei einem Workshop zu ätherischen Ölen"
    imageWidth={1536}
    imageHeight={1024}
    imagePosition="55% center"
    imageSources={[
      { type: 'image/avif', srcset: '/assets/images/optimized/workshop-01-640.avif 640w, /assets/images/optimized/workshop-01-960.avif 960w, /assets/images/optimized/workshop-01-1280.avif 1280w' },
      { type: 'image/webp', srcset: '/assets/images/optimized/workshop-01-640.webp 640w, /assets/images/optimized/workshop-01-960.webp 960w, /assets/images/optimized/workshop-01-1280.webp 1280w' },
    ]}
  >
    <p class="hero-subtitle">Ätherische Öle ruhig kennenlernen. Verständlich, persönlich und in deinem Tempo.</p>
    <p>Es geht darum, ätherische Öle verständlich einzuordnen, einfache Routinen kennenzulernen und Fragen in einem ruhigen Rahmen zu klären.</p>
    <p>Du kannst einen Workshop für dich, eine kleine Gruppe, Freunde, Familie oder ein berufliches Umfeld anfragen.</p>
  </HeroSplit>

  <section class="section workshops-outcomes" aria-labelledby="workshops-outcomes-title">
    <div class="container workshops-wrap">
      <header class="workshops-heading" data-reveal>
        <p class="eyebrow">DAS NIMMST DU MIT</p>
        <h2 id="workshops-outcomes-title">Verstehen, erleben, sicher anwenden.</h2>
        <p>In entspannter Atmosphäre lernt deine Gruppe ätherische Öle praktisch kennen. Verständlich erklärt, mit Platz für Fragen und echten Anregungen für den Alltag.</p>
      </header>
      <div class="workshops-outcomes__grid" data-consultation-cards>
        {workshopFocus.map((item,index)=>(<article class="workshops-outcome-card" data-consultation-card>
          <span class="workshops-number" aria-hidden="true">{String(index+1).padStart(2,"0")}</span>
          <p>{item}</p>
        </article>))}
      </div>
    </div>
  </section>

  <section class="section workshops-formats" aria-labelledby="workshops-formats-title">
    <div class="container workshops-wrap">
      <header class="workshops-heading" data-reveal>
        <p class="eyebrow">DEIN WORKSHOP, DEIN RAHMEN</p>
        <h2 id="workshops-formats-title">Drei Formate. Ein persönliches Erlebnis.</h2>
        <p>Zu Hause, in einer kleinen Gruppe oder im beruflichen Umfeld: Wir passen den Workshop an die Menschen an, die dabei sind.</p>
      </header>
      <div class="workshops-formats__grid" data-consultation-cards>
        {formats.map((format,index)=>(<article class="workshops-format-card" data-consultation-card>
          <div class="workshops-format-card__top"><span class="workshops-number" aria-hidden="true">{String(index+1).padStart(2,"0")}</span><span class="workshops-format-card__tag">WORKSHOP-FORMAT</span></div>
          <h3>{format.title}</h3>
          <p class="workshops-format-card__intro">{format.intro}</p>
          {format.label && <h4>{format.label}</h4>}
          {format.items && <ul>{format.items.map(item=><li>{item}</li>)}</ul>}
          {format.paragraphs && <div class="workshops-format-card__details">{format.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div>}
        </article>))}
      </div>
    </div>
  </section>

  <section class="section workshops-process" aria-labelledby="workshops-process-title">
    <div class="container workshops-wrap">
      <header class="workshops-heading" data-reveal>
        <p class="eyebrow">SO KANN ES ABLAUFEN</p>
        <h2 id="workshops-process-title">Vom ersten Kennenlernen zur eigenen Routine.</h2>
        <p>Ein übersichtlicher Ablauf mit sechs Stationen. Welche Themen wir vertiefen, stimmen wir vorher auf deine Gruppe ab.</p>
      </header>
      <ol class="workshops-process__grid" data-consultation-cards>
        {steps.map((step,index)=>(<li class="workshops-process-card" data-consultation-card>
          <span class="workshops-process-card__number" aria-hidden="true">{String(index+1).padStart(2,"0")}</span>
          <h3>{step.title.replace(/^\d+\.\s*/, "")}</h3>
        </li>))}
      </ol>
      <p class="workshops-process__note">Die Reihenfolge und Schwerpunkte stimmen wir passend zur Gruppe ab.</p>
    </div>
  </section>

  <section class="section workshops-preparation" aria-labelledby="workshops-preparation-title">
    <div class="container workshops-wrap workshops-preparation__grid" data-reveal>
      <div class="workshops-preparation__copy">
        <p class="eyebrow">GUT VORBEREITET</p>
        <h2 id="workshops-preparation-title">Ein paar Fragen und wir können loslegen.</h2>
        <p>Du brauchst keine perfekte Planung. Mit diesen fünf Antworten kann ich einen Workshop vorschlagen, der zu euch passt.</p>
        <p class="workshops-preparation__foot">Deutsch oder Englisch, privat oder im Team: Wir besprechen gemeinsam, was sinnvoll ist.</p>
      </div>
      <div class="workshops-preparation__questions">
        <ol>{preparationQuestions.map((q,index)=>(<li>
          <span class="workshops-number" aria-hidden="true">{String(index+1).padStart(2,"0")}</span>
          <span>{q}</span>
        </li>))}</ol>
      </div>
    </div>
  </section>

  <CTASection title="Lust auf einen Workshop?" primaryHref="/de/kontakt/" primaryLabel="Workshop anfragen" secondaryHref="/de/beratung/" secondaryLabel="Persönliche Beratung">
    <p>Erzähl mir kurz, wie viele Menschen teilnehmen möchten und was euch interessiert. Ich helfe dir, Format, Schwerpunkt und einen passenden Termin zu finden.</p>
  </CTASection>
  <section class="compliance-section workshops-compliance">
    <div class="container"><ComplianceNote label="HINWEIS">
      <p class="workshops-compliance__label">HINWEIS</p>
      <p>Die Workshops dienen der Information über ätherische Öle, Produkte, Routinen und sichere Verwendung. Sie ersetzen keine medizinische Beratung, Diagnose oder Behandlung. Es werden keine Heilversprechen gemacht.</p>
    </ComplianceNote></div>
  </section>
  <script is:inline src="/scripts/consultation-motion.js" defer></script>
</PageLayout>
