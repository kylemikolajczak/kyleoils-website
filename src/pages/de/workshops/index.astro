---
import ComplianceNote from '../../../components/compliance/ComplianceNote.astro';
import TopicCard from '../../../components/cards/TopicCard.astro';
import CTASection from '../../../components/cta/CTASection.astro';
import HeroSplit from '../../../components/sections/HeroSplit.astro';
import SectionIntro from '../../../components/sections/SectionIntro.astro';
import StepList from '../../../components/sections/StepList.astro';
import PageLayout from '../../../layouts/PageLayout.astro';

const workshopFocus = [
  'Was ätherische Öle sind und wie konzentriert sie sind',
  'Wie doTERRA grundsätzlich funktioniert',
  'Welche Starter-Sets es gibt und für wen sie passen können',
  'Wie man mit Diffuser, Duft und einfachen Routinen ruhig startet',
  'Was bei Verdünnung, Hautkontakt und sensiblen Personen wichtig ist',
  'Welche Fragen vor einer Bestellung sinnvoll sind',
  'Wie persönliche Begleitung nach dem Kauf aussehen kann',
];

const formats = [
  {
    title: 'Einsteiger-Workshop',
    intro: 'Für Menschen, die doTERRA noch nicht kennen oder erst einen ruhigen Überblick brauchen.',
    label: 'Gut geeignet für:',
    items: ['kleine Gruppen', 'Freunde und Familie', 'Interessenten vor dem ersten Starter-Set', 'Menschen, die erst verstehen möchten, bevor sie entscheiden'],
  },
  {
    title: 'Wohnzimmer-Workshop',
    intro: 'Ein persönlicher, kleiner Rahmen zu Hause oder in vertrauter Umgebung.',
    label: 'Gut geeignet, wenn du:',
    items: ['keine große Veranstaltung möchtest', 'mit wenigen Menschen starten willst', 'Fragen offen stellen möchtest', 'doTERRA ohne Druck erleben möchtest'],
  },
  {
    title: 'Team, Studio oder Praxis',
    intro: 'Für kleine Teams, Studios, lokale Unternehmen oder Praxisumfelder, die ätherische Öle als Thema kennenlernen möchten.',
    paragraphs: [
      'Der Fokus bleibt auf Bildung, Duft, Alltag, Sicherheit und Orientierung.',
      'Es werden keine medizinischen Aussagen gemacht und keine Anwendungen für Patienten, Kunden oder Mitarbeitende versprochen.',
    ],
  },
];

const steps = [
  { title: '1. Kurze Vorstellung von Kyle und doTERRA', paragraphs: [] },
  { title: '2. Grundverständnis ätherischer Öle', paragraphs: [] },
  { title: '3. Duft, Diffuser und einfache Alltagsroutinen', paragraphs: [] },
  { title: '4. Sicherheit, Verdünnung und sensible Situationen', paragraphs: [] },
  { title: '5. Starter-Sets ruhig einordnen', paragraphs: [] },
  { title: '6. Fragen sammeln und nächste Schritte klären', paragraphs: [] },
];

const expectations = [
  'eine ruhige Einführung',
  'klare Sprache ohne Fachchaos',
  'realistische Einordnung',
  'keine Heilversprechen',
  'keine Drucksituation',
  'Raum für Fragen',
  'Orientierung für den eigenen Alltag',
];

const notIncluded = [
  'medizinische Beratung',
  'Therapie',
  'Diagnose',
  'Behandlungsversprechen',
  'eine Pflicht zum Kauf',
  'eine Pflicht, ein Kundenkonto zu eröffnen',
  'eine Business-Veranstaltung, wenn das nicht ausdrücklich gewünscht ist',
];

const preparationQuestions = [
  'Wer nimmt teil?',
  'Geht es um Einsteiger, Kunden oder eine gemischte Gruppe?',
  'Soll es um Starter-Sets, Sicherheit, Alltag oder Duft gehen?',
  'Soll der Workshop auf Deutsch oder Englisch stattfinden?',
  'Gibt es Kinder, Haustiere oder sensible Personen im Umfeld?',
];
---

<PageLayout title="doTERRA Workshops | Kyle Oils" description="Ruhige doTERRA Workshops mit Kyle: ätherische Öle verstehen, Starter-Sets einordnen, sichere Grundlagen kennenlernen und Fragen ohne Druck klären.">
  <HeroSplit
    title="doTERRA Workshops mit Kyle"
    primaryHref="/de/kontakt/"
    primaryLabel="Workshop anfragen"
    secondaryHref="/de/beratung/"
    secondaryLabel="Beratung anfragen"
    imageSrc="/assets/images/workshops/workshop-01.png"
    imageAlt="Kleine Gruppe bei einem Workshop zu ätherischen Ölen"
    imageWidth={1536}
    imageHeight={1024}
    imagePosition="55% center"
  >
    <p class="hero-subtitle">Ätherische Öle ruhig kennenlernen. Verständlich, persönlich und ohne Verkaufsveranstaltung.</p>
    <p>Ein Workshop mit Kyle Oils ist kein lauter Verkaufsabend und kein medizinischer Vortrag.</p>
    <p>Es geht darum, ätherische Öle verständlich einzuordnen, einfache Routinen kennenzulernen und Fragen in einem ruhigen Rahmen zu klären.</p>
    <p>Du kannst einen Workshop für dich, eine kleine Gruppe, Freunde, Familie oder ein berufliches Umfeld anfragen.</p>
  </HeroSplit>

  <section class="section section--cream">
    <div class="container narrow-layout">
      <SectionIntro title="Was ein Workshop leisten soll">
        <p>Ein Workshop hilft dir und deiner Gruppe, doTERRA besser zu verstehen.</p>
        <p>Im Mittelpunkt stehen:</p>
      </SectionIntro>
      <ul class="check-list">{workshopFocus.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionIntro title="Workshop-Formate" />
      <div class="format-grid">
        {formats.map((format) => (
          <TopicCard title={format.title}>
            <p>{format.intro}</p>
            {format.label && <h4>{format.label}</h4>}
            {format.items && <ul>{format.items.map((item) => <li>{item}</li>)}</ul>}
            {format.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          </TopicCard>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--sage">
    <div class="container narrow-layout">
      <SectionIntro title="Ablauf">
        <p>Ein Workshop kann je nach Gruppe unterschiedlich aufgebaut sein.</p>
        <p>Ein typischer Ablauf:</p>
      </SectionIntro>
      <StepList steps={steps} />
      <p class="section-copy">Der Ablauf kann vorher abgestimmt werden.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow-layout">
      <SectionIntro title="Was Teilnehmer erwarten können">
        <p>Teilnehmer bekommen:</p>
      </SectionIntro>
      <ul class="check-list">{expectations.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container split-layout">
      <div>
        <SectionIntro title="Was ein Workshop nicht ist">
          <p>Ein Workshop ist nicht:</p>
        </SectionIntro>
        <ul class="check-list">{notIncluded.map((item) => <li>{item}</li>)}</ul>
      </div>
      <aside class="calm-panel">
        <h2>Ohne Druck</h2>
        <p>Der Workshop dient der Orientierung. Entscheidungen über Produkte oder ein Kundenkonto bleiben jederzeit freiwillig.</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container narrow-layout">
      <SectionIntro title="Vorbereitung">
        <p>Für einen guten Workshop helfen ein paar einfache Fragen:</p>
      </SectionIntro>
      <ul class="check-list">{preparationQuestions.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <CTASection title="Workshop anfragen" primaryHref="/de/kontakt/" primaryLabel="Workshop anfragen" secondaryHref="/de/beratung/" secondaryLabel="Beratung anfragen">
    <p>Wenn du einen Workshop mit Kyle anfragen möchtest, kannst du kurz schreiben, für wen der Workshop gedacht ist und welcher Rahmen passend wäre.</p>
    <p>Kyle meldet sich mit einer ruhigen Einschätzung, ob und wie ein Workshop sinnvoll passt.</p>
  </CTASection>

  <section class="compliance-section">
    <div class="container">
      <ComplianceNote label="Hinweis">
        <h2>Hinweis</h2>
        <p>Kyle Oils ersetzt keine medizinische Beratung und gibt keine Heilversprechen. Workshops dienen der verständlichen Einordnung von doTERRA Produkten, Routinen und Sicherheitsfragen.</p>
      </ComplianceNote>
    </div>
  </section>
</PageLayout>

<style>
  .section { padding: var(--space-64) 0; }
  .section--cream { background: var(--color-soft-cream); }
  .section--sage { background: rgb(168 184 160 / 20%); }
  .narrow-layout { max-width: var(--container-text); }
  .hero-subtitle { color: var(--color-deep-forest); font-size: var(--font-size-h3-mobile); font-weight: var(--font-weight-semibold); }
  .check-list { display: grid; gap: var(--space-16); margin: 0; padding: 0; list-style: none; }
  .check-list li { position: relative; padding-left: var(--space-32); color: var(--color-text-secondary); }
  .check-list li::before { content: ''; position: absolute; top: .72em; left: 0; width: 11px; height: 11px; border-radius: 50%; background: var(--color-sage-green); }
  .format-grid, .split-layout { display: grid; gap: var(--space-24); }
  .format-grid :global(.topic-card h4) { margin: var(--space-20) 0 var(--space-12); font-size: var(--font-size-body-mobile); }
  .format-grid :global(.topic-card ul) { display: grid; gap: var(--space-12); margin: 0; padding-left: var(--space-24); }
  .format-grid :global(.topic-card p + p) { margin-top: var(--space-16); }
  .section-copy { margin: var(--space-32) 0 0; color: var(--color-text-secondary); }
  .calm-panel { align-self: start; padding: var(--space-32); border-radius: var(--radius-section); background: var(--color-warm-white); box-shadow: var(--shadow-card); }
  .calm-panel h2 { margin: 0 0 var(--space-16); font-size: var(--font-size-h3-mobile); line-height: 1.2; }
  .calm-panel p { margin: 0; color: var(--color-text-secondary); }
  .compliance-section { padding: 0 0 var(--space-80); }
  .compliance-section :global(h2) { margin: 0 0 var(--space-12); font-size: var(--font-size-body-mobile); }
  @media (min-width: 768px) { .section { padding-block: var(--space-96); } .format-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .section { padding-block: var(--space-120); } .format-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .split-layout { grid-template-columns: minmax(0, 1fr) minmax(320px, .72fr); gap: var(--space-80); } .hero-subtitle { font-size: var(--font-size-h3-desktop); } }
</style>
