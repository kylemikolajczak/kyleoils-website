const decisionGuides = [
  { title: 'Welches doTERRA Starter-Set passt zu mir?', href: '/de/wissen/produkte-systeme/welches-doterra-starter-set-passt-zu-mir/' },
  { title: 'LRP Treueprogramm verständlich erklärt', href: '/de/wissen/produkte-systeme/lrp-treueprogramm-ruhig-erklaert/' },
  { title: 'doTERRA Kundenkonto einfach erklärt', href: '/de/wissen/produkte-systeme/doterra-kundenkonto-einfach-erklaert/' },
];

const decisionOptions = [
  { title: 'Kompakter Öl-Einstieg', copy: 'Family Essentials Kit für einen überschaubaren Beginn mit ätherischen Ölen.', href: '#family-essentials-kit' },
  { title: 'Zuhause & Diffuser', copy: 'Home Essentials Kit für eine breitere Ausstattung mit Diffuser.', href: '#home-essentials-kit' },
  { title: 'Tägliche Wellness-Routine', copy: 'Wellness Made Simple für einen systematischen Produkt-Einstieg.', href: '#wellness-made-simple' },
  { title: 'Systemorientierter Start', copy: 'MetaPWR System für Menschen, die gezielt ein abgestimmtes System betrachten möchten.', href: '#metapwr-system' },
];
---

<PageLayout lang="de" title="Dein Einstieg. Deine Routine. Dein Set. | Kyle Oils" description="Vier offizielle doTERRA Starter-Sets im Vergleich. Entdecke passende Öle für deinen Alltag und die Vorteile eines doTERRA-Kundenkontos.">
  <section class="hero starter-sets-hero">
    <div class="container hero__grid">
      <div class="hero__content">
        <p class="eyebrow">DEIN START MIT DOTERRA</p>
        <h1>Dein Einstieg. Deine Routine. Dein Set.</h1>
        <div class="hero__copy"><p>Vier offizielle Starter-Optionen, verständlich verglichen. Finde das Paket, das zu dir und deinen Alltagsroutinen passt – und nutze die Vorteile eines passenden doTERRA-Kundenkontos.</p></div>
        <p class="starter-hero__deal"><strong>25 %</strong><span>unter dem regulären Verkaufspreis mit geeigneter Kundenmitgliedschaft. Kein zusätzlicher Rabatt auf einen bereits ausgewiesenen Setpreis.</span></p>
        <div class="starter-hero__buttons"><a class="starter-button starter-button--primary" href="#starter-options">Set entdecken</a><a class="starter-button starter-button--secondary" href="/de/kontakt/">Beratung anfragen</a></div>
      </div>
      <ResponsiveImage
        src="/assets/images/products/starter-sets-hero-lifestyle.png"
        alt="Diffuser, ätherische Öle und eine Tasse in ruhiger Atmosphäre"
        width={1672}
        height={941}
        variant="portrait-wide"
        position="67% center"
        treatment="hero"
        priority
        sources={[
          { type: 'image/avif', srcset: '/assets/images/optimized/starter-sets-hero-lifestyle-640.avif 640w, /assets/images/optimized/starter-sets-hero-lifestyle-960.avif 960w, /assets/images/optimized/starter-sets-hero-lifestyle-1280.avif 1280w' },
          { type: 'image/webp', srcset: '/assets/images/optimized/starter-sets-hero-lifestyle-640.webp 640w, /assets/images/optimized/starter-sets-hero-lifestyle-960.webp 960w, /assets/images/optimized/starter-sets-hero-lifestyle-1280.webp 1280w' },
        ]}
      />
    </div>
  </section>
  <section class="section starter-decision">
    <div class="container starter-main-container">
      <header class="starter-section-heading" data-reveal><p class="eyebrow">FINDE DEINEN EINSTIEG</p><h2>Welcher Start passt zu dir?</h2><p>Vier Wege, ein guter Anfang. Wähle die Richtung, die für deinen Alltag Sinn ergibt.</p></header>
      <div class="starter-decision__grid" data-consultation-cards>
      {decisionOptions.map((option,index)=><a class="starter-decision__card" href={option.href} data-consultation-card>
        <span class="starter-card-index">{String(index+1).padStart(2,"0")}</span><h3>{option.title}</h3><p>{option.copy}</p><span class="starter-card-more">Set entdecken ↗</span>
      </a>)}
      </div>
    </div>
  </section>
  <section class="section starter-offers" id="starter-options">
    <div class="container starter-main-container">
      <header class="starter-section-heading" data-reveal><p class="eyebrow">DIE VIER OFFIZIELLEN OPTIONEN</p><h2>Entdecke dein Starter-Set.</h2><p>Die Produktbilder, Inhalte und meine Einschätzung helfen dir beim Vergleich. Alle direkten Shop-Buttons auf dieser Seite führen ausschließlich zum deutschen doTERRA-Shop.</p></header>
      <aside class="starter-international">
        <div class="starter-international__copy"><p class="eyebrow">WICHTIG FÜR INTERNATIONALE BESUCHER</p><h3>Du lebst außerhalb Deutschlands?</h3><p>Die direkten Bestelllinks auf dieser Seite führen ausschließlich zum offiziellen deutschen Shop. Schreib mir dein Land und welches Starter-Set du möchtest. Ich prüfe für dich die verfügbaren Optionen und helfe dir, den offiziellen Bestellweg in deinem Land und die dort geltenden Einkaufspreise zu finden.</p><small>Verfügbarkeit, Währung, Bedingungen und Preise können je nach Land abweichen.</small></div>
        <a href="/de/kontakt/" class="starter-button starter-button--primary">Internationales Starter-Set anfragen</a>
      </aside>
      <aside class="starter-pricing"><strong>25 %</strong><div><p class="eyebrow">25 % KUNDENVORTEIL</p><p>Als registrierter doTERRA-Vorteilskunde erhältst du in der Regel Einkaufspreise 25 % unter dem regulären Verkaufspreis. Das ist kein zusätzlicher Abzug vom bereits ausgewiesenen Starter-Set-Preis. Ich helfe dir persönlich bei Auswahl, Kontoanlage und Einstieg.</p></div></aside>
      <div class="starter-set-list">
        {starterSets.map((set,index)=><div id={set.anchorId} class="starter-set-anchor" tabindex="-1">
          <StarterSetCard title={set.title} imageSrc={set.imageSrc} imageAlt={set.imageAlt} imageWidth={set.imageWidth} imageHeight={set.imageHeight}
            orderHref={set.orderHref} orderLabel="Im deutschen Shop bestellen" consultationHref="/de/kontakt/" consultationLabel="Andere Länder? Kyle fragen"
            kitIndex={index+1} countryLabel="OFFIZIELLER SHOP · NUR DEUTSCHLAND" priceNotice="25 % gegenüber regulären Verkaufspreisen bei berechtigtem Kundenkonto – nicht zusätzlich auf angezeigte Setpreise.">
              <p class="starter-set-lead">{set.lead}</p>
              {set.sections.map((section)=><section><h4>{section.title}</h4>
                {"items" in section && <ul class="starter-set-points">{section.items.map(item=><li>{item}</li>)}</ul>}
                {"paragraphs" in section && section.paragraphs.map(paragraph=><p>{paragraph}</p>)}
              </section>)}
          </StarterSetCard>
        </div>)}
      </div>
    </div>
  </section>
  <section class="section starter-benefits">
    <div class="container starter-main-container starter-benefits__grid">
      <article class="starter-benefits__account" data-reveal><p class="eyebrow">DEINE VORTEILE</p><h2>Ein Kundenkonto, das sich lohnt.</h2><p>Mit dem passenden doTERRA-Vorteilskundenkonto erhältst du Einkaufspreise und hast mit mir einen direkten Ansprechpartner für Fragen und deine ersten Routinen.</p><ul><li><span>01</span><p>25 % Einkaufspreisvorteil gegenüber regulären Verkaufspreisen</p></li><li><span>02</span><p>Persönliche Hilfe bei Kontoanlage, Set-Auswahl und Anwendung</p></li><li><span>03</span><p>Keine verpflichtende monatliche Bestellung als Vorteilskunde</p></li></ul></article>
      <article class="starter-benefits__before" data-reveal><p class="eyebrow">VOR DEINER BESTELLUNG</p><h2>Kauf das Set, das du wirklich nutzt.</h2><p>Starte bewusst: Willst du verschiedene Öle kennenlernen, einen Diffuser verwenden oder gezielt ein Wellness-System ausprobieren? Für alles gibt es einen passenden Einstieg. Du musst nicht das größte Paket wählen.</p><ul><li>Öle für den Einstieg und die Familie</li><li>Ein Diffuser und eine breitere Grundausstattung</li><li>Produkte für tägliche Wellness-Routinen</li><li>Ein gezielter Start mit MetaPWR</li></ul></article>
    </div>
  </section>
  <section class="section starter-guides">
    <div class="container starter-main-container">
      <header class="starter-section-heading" data-reveal><p class="eyebrow">WISSEN VOR DEM KAUF</p><h2>Gut vorbereitet bestellen.</h2><p>Die drei Ratgeber erklären dir Set-Unterschiede, das Kundenkonto und das Treueprogramm.</p></header>
      <div class="starter-guides__grid" data-consultation-cards>{decisionGuides.map((guide,index)=><a href={guide.href} class="starter-guides__card" data-consultation-card>
        <span class="starter-card-index">{String(index+1).padStart(2,"0")}</span><h3>{guide.title}</h3><span class="starter-card-more">Ratgeber öffnen ↗</span>
      </a>)}</div>
    </div>
  </section>
  <section class="section starter-orientation">
    <div class="container starter-main-container">
      <header class="starter-section-heading" data-reveal><p class="eyebrow">GUT STARTEN</p><h2>Und nach deiner ersten Bestellung?</h2></header>
      <div class="starter-orientation__grid">
        <article><span class="starter-card-index">01</span><h3>Startbereich</h3><p>Lerne im Startbereich die Grundlagen sicherer Anwendung kennen.</p><a class="starter-button starter-button--secondary" href="/de/startbereich/">Zum Startbereich</a></article>
        <article><span class="starter-card-index">02</span><h3>30-Tage-Startplan</h3><p>Mit dem kostenlosen 30-Tage-Plan kommst du entspannt in deine eigenen Routinen.</p><a class="starter-button starter-button--secondary" href="/de/30-tage-startplan/">30-Tage-Startplan ansehen</a></article>
      </div>
    </div>
  </section>
  <CTASection title="Bereit für deinen doTERRA-Start?" primaryHref="/de/kontakt/" primaryLabel="Mit Kyle Kontakt aufnehmen" secondaryHref={contactLinks.whatsapp.href} secondaryLabel="WhatsApp starten"><p>Du kannst dein Set im deutschen Shop bestellen. Du wohnst im Ausland oder willst wissen, welche Option zu dir passt? Schreib mir und wir finden deinen offiziellen Bestellweg.</p></CTASection>
  <section class="compliance-section starter-compliance"><div class="container"><ComplianceNote label="HINWEIS"><p class="starter-compliance__label">HINWEIS</p><p>25 % bezieht sich auf den regulären Verkaufspreis bei entsprechender doTERRA-Mitgliedschaft, nicht auf einen zusätzlichen Nachlass auf Starter-Sets. Aktuelle Preise, Konditionen und Verfügbarkeit bestimmt doTERRA. Meine Begleitung ersetzt keine medizinische Beratung.</p></ComplianceNote></div></section>
  <script is:inline src="/scripts/consultation-motion.js" defer></script>
</PageLayout>
