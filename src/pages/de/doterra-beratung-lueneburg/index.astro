---
import ComplianceNote from '../../../components/compliance/ComplianceNote.astro';
import CTAGroup from '../../../components/cta/CTAGroup.astro';
import CTASection from '../../../components/cta/CTASection.astro';
import SectionIntro from '../../../components/sections/SectionIntro.astro';
import PageLayout from '../../../layouts/PageLayout.astro';

const audience = [
  'in Lüneburg oder Umgebung wohnst',
  'natürliche Routinen kennenlernen möchtest',
  'doTERRA noch nicht richtig einordnen kannst',
  'wissen möchtest, welches Starter-Set zu dir passt',
  'Fragen zu Anwendung, Verdünnung oder Alltag hast',
  'lieber persönlich fragst, bevor du bestellst',
  'Deutsch oder Englisch sprechen möchtest',
];

const questions = [
  'Was ist doTERRA eigentlich?',
  'Welche Öle eignen sich für einen einfachen Einstieg?',
  'Welches Starter-Set ist sinnvoll, welches vielleicht zu viel?',
  'Wie startet man mit Diffuser, Duft und einfachen Routinen?',
  'Was ist bei Kindern, Haustieren oder sensibler Haut wichtig?',
  'Wie funktioniert ein offizielles doTERRA Kundenkonto?',
  'Was passiert nach dem Kauf?',
];

const contactOptions = ['per WhatsApp', 'per Telefon', 'per Video', 'persönlich nach Absprache', 'auf Deutsch oder Englisch'];
---

<PageLayout title="doTERRA Beratung in Lüneburg | Kyle Oils" description="Persönliche doTERRA Beratung in Lüneburg und online: Starter-Sets verstehen, ätherische Öle ruhig einordnen und sicher starten. Ohne Druck und ohne Heilversprechen.">
  <section class="guidance-hero">
    <div class="container guidance-hero__inner">
      <p class="eyebrow">LÜNEBURG & ONLINE</p>
      <h1>doTERRA Beratung in Lüneburg</h1>
      <p class="guidance-hero__subtitle">Ätherische Öle ruhig kennenlernen, persönlich einordnen und sicher starten.</p>
      <div class="guidance-hero__copy">
        <p>Wenn du in Lüneburg oder Umgebung lebst und doTERRA ätherische Öle kennenlernen möchtest, musst du nicht direkt alleine durch den Shop klicken.</p>
        <p>Kyle Oils bietet dir eine ruhige persönliche Orientierung. Du kannst Fragen stellen, Starter-Sets einordnen, erste Routinen verstehen und klären, welche Produkte wirklich zu deinem Alltag passen.</p>
        <p>Ohne Verkaufsveranstaltung. Ohne Heilversprechen. Ohne Druck.</p>
      </div>
      <CTAGroup primaryHref="/de/kontakt/" primaryLabel="Beratung anfragen" secondaryHref="/de/startbereich/" secondaryLabel="Startpfad ansehen" />
    </div>
  </section>

  <section class="section section--cream">
    <div class="container narrow-layout">
      <SectionIntro title="Für wen ist diese Beratung gedacht?" />
      <ul class="check-list">{audience.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container narrow-layout">
      <SectionIntro title="Was du mit Kyle klären kannst">
        <p>In einer ruhigen Beratung kannst du zum Beispiel klären:</p>
      </SectionIntro>
      <ul class="check-list">{questions.map((question) => <li>{question}</li>)}</ul>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container guidance-grid">
      <div>
        <SectionIntro title="Beratung in Lüneburg und online">
          <p>Kyle Oils ist nicht an ein Ladenlokal gebunden.</p>
          <p>Je nach Situation ist Beratung möglich:</p>
        </SectionIntro>
        <ul class="check-list">{contactOptions.map((option) => <li>{option}</li>)}</ul>
      </div>
      <aside class="clarity-panel">
        <h2>Der wichtigste Punkt ist nicht der Kanal, sondern die Klarheit.</h2>
        <p>Du sollst verstehen, was du brauchst und was du nicht brauchst.</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container narrow-layout">
      <SectionIntro title="Erst verstehen, dann entscheiden">
        <p>Viele Menschen bestellen zu schnell oder kaufen ein Set, das nicht wirklich zum Alltag passt.</p>
        <p>Deshalb ist die Beratung bei Kyle Oils bewusst ruhig aufgebaut.</p>
        <p>Du kannst zuerst lesen, dann Fragen sammeln und erst danach entscheiden.</p>
      </SectionIntro>
    </div>
  </section>

  <CTASection title="Persönliche Beratung anfragen" primaryHref="/de/kontakt/" primaryLabel="Beratung anfragen">
    <p>Wenn du aus Lüneburg, Umgebung oder Deutschland kommst und doTERRA ruhig kennenlernen möchtest, kannst du Kyle eine unverbindliche Anfrage senden.</p>
    <p>Du bekommst keine Verkaufsveranstaltung, sondern eine klare Einordnung für deinen Alltag.</p>
  </CTASection>

  <section class="compliance-section">
    <div class="container">
      <ComplianceNote label="Hinweis">
        <h2>Hinweis</h2>
        <p>Kyle Oils ersetzt keine medizinische Beratung und gibt keine Heilversprechen. Die Inhalte helfen dir, doTERRA Produkte, Routinen und Sicherheitsfragen verständlich einzuordnen.</p>
      </ComplianceNote>
    </div>
  </section>
</PageLayout>

<style>
  .guidance-hero, .section { padding: var(--space-64) 0; }
  .guidance-hero { background: var(--color-warm-white); }
  .guidance-hero__inner, .narrow-layout { max-width: var(--container-text); }
  .eyebrow { margin: 0 0 var(--space-16); color: var(--color-olive-grey); font-size: var(--font-size-small); font-weight: var(--font-weight-semibold); letter-spacing: .04em; text-transform: uppercase; }
  h1, h2 { margin: 0; line-height: var(--line-height-heading); letter-spacing: -.025em; }
  h1 { margin-bottom: var(--space-16); font-size: var(--font-size-h1-mobile); }
  .guidance-hero__subtitle { margin: 0 0 var(--space-24); color: var(--color-deep-forest); font-size: var(--font-size-h3-mobile); font-weight: var(--font-weight-semibold); }
  .guidance-hero__copy { margin-bottom: var(--space-32); color: var(--color-text-secondary); }
  .guidance-hero__copy p, .clarity-panel p { margin: 0 0 var(--space-16); }
  .guidance-hero__copy p:last-child, .clarity-panel p:last-child { margin-bottom: 0; }
  .section--cream { background: var(--color-soft-cream); }
  .check-list { display: grid; gap: var(--space-16); margin: 0; padding: 0; list-style: none; }
  .check-list li { position: relative; padding-left: var(--space-32); color: var(--color-text-secondary); }
  .check-list li::before { content: ''; position: absolute; top: .72em; left: 0; width: 11px; height: 11px; border-radius: 50%; background: var(--color-sage-green); }
  .guidance-grid { display: grid; gap: var(--space-40); align-items: start; }
  .clarity-panel { padding: var(--space-32); border-radius: var(--radius-section); background: var(--color-warm-white); box-shadow: var(--shadow-card); }
  .clarity-panel h2 { margin-bottom: var(--space-16); font-size: var(--font-size-h3-mobile); }
  .clarity-panel p { color: var(--color-text-secondary); }
  .compliance-section { padding: 0 0 var(--space-80); }
  .compliance-section :global(h2) { margin: 0 0 var(--space-12); font-size: var(--font-size-body-mobile); }
  @media (min-width: 768px) { .guidance-hero, .section { padding-block: var(--space-96); } .guidance-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-64); } }
  @media (min-width: 1024px) { .guidance-hero, .section { padding-block: var(--space-120); } h1 { font-size: var(--font-size-h1-desktop); } }
</style>
