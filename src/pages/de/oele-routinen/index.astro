---
import ComplianceNote from '../../../components/compliance/ComplianceNote.astro';
import CTASection from '../../../components/cta/CTASection.astro';
import ResponsiveImage from '../../../components/global/ResponsiveImage.astro';
import TopicCard from '../../../components/cards/TopicCard.astro';
import HeroSplit from '../../../components/sections/HeroSplit.astro';
import SectionIntro from '../../../components/sections/SectionIntro.astro';
import PageLayout from '../../../layouts/PageLayout.astro';

const applicationMethods = [
  { title: 'Aromatisch', copy: 'Über den Duft, etwa im Diffuser, direkt aus dem geöffneten Fläschchen oder als bewusster Duftmoment.' },
  { title: 'Äußerlich', copy: 'Auf der Haut, zum Beispiel verdünnt mit einem geeigneten Trägeröl oder als Teil einer Massage- und Pflegeroutine.' },
  { title: 'Innerlich', copy: 'Nur bei Produkten, die ausdrücklich dafür gekennzeichnet sind, und ausschließlich entsprechend der jeweiligen Gebrauchsanweisung.' },
];

const intentPaths = [
  { title: 'Stressige Tage & kleine Pausen', copy: 'Duftanker und kleine Pausen für Tage, die viel von dir fordern.', href: '/de/wissen/produkte-systeme/adaptiv-stressiger-alltag-duftanker/' },
  { title: 'Abend & Schlafroutine', copy: 'Eine angenehme Abendumgebung und bewusste Rituale rund um die Schlafenszeit.', href: '/de/wissen/produkte-systeme/serenity-abend-schlafroutine-sicher-einordnen/' },
  { title: 'Bewegung, Massage & Körperpflege', copy: 'Pflege, Massage und Routinen nach aktiven Tagen.', href: '/de/wissen/produkte-systeme/deep-blue-bewegung-massage-koerperkomfort/' },
  { title: 'Mahlzeiten, Reisen & Routinen', copy: 'Produkt- und Routinewissen rund um Mahlzeiten, Reisen und bewusste Gewohnheiten.', href: '/de/wissen/produkte-systeme/zengest-bauchgefuehl-essensalltag/' },
  { title: 'Familie & sichere Anwendung', copy: 'Sicherheitswissen für Haushalte, in denen Menge, Raumgröße und Rücksicht wichtig sind.', href: '/de/wissen/sicher-anwenden/' },
  { title: 'Zuhause & Routinen', copy: 'Raumduft, Haushalt und kleine Gewohnheiten, die zu deinem Zuhause passen.', href: '/de/wissen/alltag/' },
];
---

<PageLayout title="Ätherische Öle im Alltag | Anwendung & Routinen | Kyle Oils" description="Ätherische Öle praktisch einordnen: aromatische, topische und labelbewusste Anwendung sowie Routinen, die zu deinem Alltag passen.">
  <HeroSplit title="Ätherische Öle im Alltag" primaryHref="/de/wissen/" primaryLabel="Wissen entdecken" secondaryHref="/de/kontakt/" secondaryLabel="Mit Kyle besprechen" imageSrc="/assets/images/products/essential-oils-display.jpg" imageAlt="Ätherische Öle übersichtlich in einer Holzhalterung" imageWidth={2400} imageHeight={3600} imagePosition="54% center" imageSources={[{ type: 'image/avif', srcset: '/assets/images/optimized/essential-oils-display-640.avif 640w, /assets/images/optimized/essential-oils-display-960.avif 960w, /assets/images/optimized/essential-oils-display-1280.avif 1280w' }, { type: 'image/webp', srcset: '/assets/images/optimized/essential-oils-display-640.webp 640w, /assets/images/optimized/essential-oils-display-960.webp 960w, /assets/images/optimized/essential-oils-display-1280.webp 1280w' }]}>
    <p>Ätherische Öle entfalten ihren Wert, wenn sie einen echten Platz in deinen Gewohnheiten finden.</p>
    <p>Verstehe Anwendung und Themen zuerst. Produkte folgen, wenn sie wirklich passen.</p>
  </HeroSplit>

  <section class="section"><div class="container"><SectionIntro title="Drei Arten der Anwendung"><p>Je nach Produkt können ätherische Öle über Duft, auf der Haut oder labelbewusst innerlich verwendet werden.</p></SectionIntro><div class="application-grid">{applicationMethods.map((method) => <TopicCard title={method.title}><p>{method.copy}</p></TopicCard>)}</div><p class="safety-note">Nicht jedes Öl eignet sich für jede Anwendungsart. Maßgeblich sind immer Etikett und Produktverpackung. Bei Unsicherheit, Schwangerschaft, Stillzeit, Kindern oder bestehenden gesundheitlichen Fragen ist fachlicher Rat wichtig.</p></div></section>

  <section class="section section--sage"><div class="container"><SectionIntro title="Wo möchtest du anfangen?"><p>Wähle das Thema, das gerade zu deinem Leben passt. Von dort führt dich das Wissen Schritt für Schritt weiter.</p></SectionIntro><div class="intent-grid">{intentPaths.map((path) => <a class="intent-card" href={path.href}><h2>{path.title}</h2><p>{path.copy}</p><span aria-hidden="true">Entdecken →</span></a>)}</div></div></section>

  <section class="section section--cream"><div class="container split-layout"><div><SectionIntro title="Eine Routine, die wirklich bleibt"><p>Ein guter Einstieg muss nicht groß sein. Ein Duftmoment am Morgen, eine Massage nach Bewegung oder ein bewusst gestalteter Raum können reichen.</p><p>Wähle einen Anlass, eine Anwendung und eine kleine Gewohnheit, die sich leicht wiederholen lässt. So entsteht aus Neugier praktische Erfahrung.</p></SectionIntro></div><ResponsiveImage src="/assets/images/products/diffuser-lemon.jpg" alt="Diffuser und ätherisches Zitronenöl in einer hellen Umgebung" width={3600} height={2400} variant="portrait-wide" position="58% center" sources={[{ type: 'image/avif', srcset: '/assets/images/optimized/diffuser-lemon-640.avif 640w, /assets/images/optimized/diffuser-lemon-960.avif 960w, /assets/images/optimized/diffuser-lemon-1280.avif 1280w' }, { type: 'image/webp', srcset: '/assets/images/optimized/diffuser-lemon-640.webp 640w, /assets/images/optimized/diffuser-lemon-960.webp 960w, /assets/images/optimized/diffuser-lemon-1280.webp 1280w' }]}/></div></section>

  <section class="section knowledge-continuation"><div class="container narrow-layout"><SectionIntro title="Im Wissensbereich weiterlernen"><p>Im Wissensbereich findest du Ölprofile, sichere Anwendung, Routinen und Produktwissen. So kannst du vertiefen, bevor du etwas auswählst.</p></SectionIntro><a class="knowledge-continuation__link" href="/de/wissen/">Zum Wissensbereich <span aria-hidden="true">→</span></a></div></section>

  <CTASection title="Fragen zu deinem Einstieg?" primaryHref="/de/kontakt/" primaryLabel="Mit Kyle sprechen"><p>Wenn du ein Thema besser einordnen möchtest, schauen wir gemeinsam auf einen passenden nächsten Schritt.</p></CTASection>
  <section class="compliance-section"><div class="container"><ComplianceNote><h2>Kurzer Hinweis</h2><p>Meine Beratung ersetzt keine medizinische Diagnose oder Behandlung. Ätherische Öle und Wellness-Produkte können Teil bewusster Routinen sein, ersetzen aber keine medizinische Betreuung.</p></ComplianceNote></div></section>
</PageLayout>

<style>
  .section { padding: var(--space-64) 0; } .section--cream { background: var(--color-soft-cream); } .section--sage { background: rgb(168 184 160 / 20%); } .narrow-layout { max-width: var(--container-text); } .application-grid, .intent-grid, .split-layout { display: grid; gap: var(--space-20); }
  .safety-note { max-width: var(--container-text); margin: var(--space-32) 0 0; padding: var(--space-24); border: 1px solid rgb(216 199 173 / 70%); border-radius: var(--radius-card); background: var(--color-soft-cream); color: var(--color-text-secondary); }
  .intent-card { display: grid; gap: var(--space-12); min-height: 190px; padding: var(--space-24); border: 1px solid rgb(216 199 173 / 70%); border-radius: var(--radius-card); background: var(--color-warm-white); box-shadow: var(--shadow-card); color: var(--color-text-primary); text-decoration: none; }
  .intent-card h2, .intent-card p { margin: 0; } .intent-card h2 { font-size: var(--font-size-h3-mobile); line-height: 1.2; } .intent-card p { color: var(--color-text-secondary); } .intent-card span { align-self: end; margin-top: auto; color: var(--color-deep-forest); font-size: var(--font-size-small); font-weight: var(--font-weight-semibold); } .intent-card:hover, .intent-card:focus-visible { border-color: var(--color-sage-green); }
  .knowledge-continuation { background: var(--color-warm-white); } .knowledge-continuation__link { display: inline-flex; align-items: center; gap: var(--space-8); min-height: 48px; color: var(--color-deep-forest); font-weight: var(--font-weight-semibold); text-decoration: none; } .knowledge-continuation__link:hover, .knowledge-continuation__link:focus-visible { text-decoration: underline; }
  .compliance-section { padding: 0 0 var(--space-80); } .compliance-section :global(h2) { margin: 0 0 var(--space-12); font-size: var(--font-size-body-mobile); }
  @media (min-width: 768px) { .section { padding-block: var(--space-96); } .application-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .intent-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-24); } }
  @media (min-width: 1024px) { .section { padding-block: var(--space-120); } .intent-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .split-layout { grid-template-columns: minmax(0, 1fr) minmax(360px, .82fr); gap: var(--space-80); align-items: center; } }
</style>
