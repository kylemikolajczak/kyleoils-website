---
import ComplianceNote from '../../../components/compliance/ComplianceNote.astro';
import CTASection from '../../../components/cta/CTASection.astro';
import ResponsiveImage from '../../../components/global/ResponsiveImage.astro';
import HeroSplit from '../../../components/sections/HeroSplit.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import '../../../styles/oils-routines-refined.css';

const applicationMethods = [
  { title: 'Aromatisch', copy: 'Über den Duft, etwa im Diffuser, direkt aus dem geöffneten Fläschchen oder als bewusster Duftmoment.' },
  { title: 'Äußerlich', copy: 'Auf der Haut, zum Beispiel verdünnt mit einem geeigneten Trägeröl oder als Teil einer Massage- und Pflegeroutine.' },
  { title: 'Innerlich', copy: 'Nur bei Produkten, die ausdrücklich dafür gekennzeichnet sind, und ausschließlich entsprechend der jeweiligen Gebrauchsanweisung.' },
];

const intentPaths = [
  { title: 'Stressige Tage & kleine Pausen', copy: 'Duftanker und kleine Pausen für Tage, die viel von dir fordern.', href: '/de/wissen/produkte-systeme/adaptiv-stressiger-alltag-duftanker/' },
  { title: 'Abend & Schlafroutine', copy: 'Eine angenehme Abendumgebung und bewusste Rituale rund um die Schlafenszeit.', href: '/de/wissen/produkte-systeme/serenity-abend-schlafroutine-sicher-einordnen/' },
  { title: 'Bewegung, Massage & Körperpflege', copy: 'Pflege, Massage und Routinen nach aktiven Tagen.', href: '/de/wissen/produkte-systeme/deep-blue-bewegung-massage-koerperkomfort/' },
  { title: 'Mahlzeiten, Reisen & Routinen', copy: 'Produkt- und Routinewissen rund um Mahlzeiten, Reisen und bewusste Gewohnheiten.', href: '/de/wissen/produkte-systeme/zengest-bauchgefuehl-essensalltag/' },
  { title: 'Familie & sichere Anwendung', copy: 'Sicherheitswissen für Haushalte, in denen Menge, Raumgröße und Rücksicht wichtig sind.', href: '/de/wissen/sicher-anwenden/' },
  { title: 'Zuhause & Routinen', copy: 'Raumduft, Haushalt und kleine Gewohnheiten, die zu deinem Zuhause passen.', href: '/de/wissen/alltag/' },
];
---

<PageLayout title="Ätherische Öle im Alltag | Anwendung & Routinen | Kyle Oils" description="Ätherische Öle praktisch einordnen: aromatische, topische und labelbewusste Anwendung sowie Routinen, die zu deinem Alltag passen.">
  <HeroSplit title="Ätherische Öle im Alltag" primaryHref="/de/wissen/" primaryLabel="Wissen entdecken" secondaryHref="/de/kontakt/" secondaryLabel="Mit Kyle besprechen" imageSrc="/assets/images/products/essential-oils-display.jpg" imageAlt="Ätherische Öle übersichtlich in einer Holzhalterung" imageWidth={2400} imageHeight={3600} imagePosition="54% center" imageSources={[{ type: 'image/avif', srcset: '/assets/images/optimized/essential-oils-display-640.avif 640w, /assets/images/optimized/essential-oils-display-960.avif 960w, /assets/images/optimized/essential-oils-display-1280.avif 1280w' }, { type: 'image/webp', srcset: '/assets/images/optimized/essential-oils-display-640.webp 640w, /assets/images/optimized/essential-oils-display-960.webp 960w, /assets/images/optimized/essential-oils-display-1280.webp 1280w' }]}>
    <p>Ätherische Öle entfalten ihren Wert, wenn sie einen echten Platz in deinen Gewohnheiten finden.</p>
    <p>Verstehe Anwendung und Themen zuerst. Produkte folgen, wenn sie wirklich passen.</p>
  </HeroSplit>

  <section class="section oils-methods" aria-labelledby="oils-methods-title">
    <div class="container oils-layout" data-reveal>
      <header class="oils-section-heading">
        <p class="eyebrow">ANWENDUNG VERSTEHEN</p>
        <h2 id="oils-methods-title">Drei Wege, ätherische Öle kennenzulernen.</h2>
        <p>Duft, Hautpflege und – nur bei ausdrücklich geeigneten Produkten – die innere Anwendung. Entscheidend ist immer, was auf dem jeweiligen Produkt steht.</p>
      </header>
      <div class="oils-methods__grid" data-consultation-cards>
        {applicationMethods.map((method, index) => (
          <article class="oils-method-card" data-consultation-card>
            <span class="oils-card-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{method.title}</h3>
            <p>{method.copy}</p>
          </article>
        ))}
      </div>
      <aside class="oils-safety-note" aria-label="SICHER ANWENDEN">
        <span class="oils-safety-note__title">SICHER ANWENDEN</span>
        <p>Nicht jedes Öl eignet sich für jede Anwendungsart. Maßgeblich sind immer Etikett und Produktverpackung. Bei Unsicherheit, Schwangerschaft, Stillzeit, Kindern oder bestehenden gesundheitlichen Fragen ist fachlicher Rat wichtig.</p>
      </aside>
    </div>
  </section>

  <section class="section oils-interests" aria-labelledby="oils-interests-title">
    <div class="container oils-layout">
      <header class="oils-section-heading" data-reveal>
        <p class="eyebrow">WAS PASST ZU DEINEM ALLTAG?</p>
        <h2 id="oils-interests-title">Kleine Rituale. Große Vielfalt.</h2>
        <p>Du musst nicht alles gleichzeitig ausprobieren. Starte mit einem Bereich, der sich für dich sinnvoll anfühlt.</p>
      </header>
      <div class="oils-interests__grid" data-consultation-cards>
        {intentPaths.map((path, index) => (
          <a class="oils-interest-card" href={path.href} data-consultation-card>
            <span class="oils-card-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{path.title}</h3>
            <p>{path.copy}</p>
            <span class="oils-interest-card__more">Thema entdecken <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section oils-routine" aria-labelledby="oils-routine-title">
    <div class="container oils-routine__grid" data-reveal>
      <div class="oils-routine__text">
        <p class="eyebrow">WENIGER IST OFT MEHR</p>
        <h2 id="oils-routine-title">Eine Routine, die wirklich bleibt.</h2>
        <p>Ein guter Einstieg muss nicht groß sein. Ein Duftmoment am Morgen, eine Massage nach Bewegung oder ein bewusst gestalteter Raum können reichen.</p>
        <p>Wähle einen Anlass, eine sichere Anwendung und eine kleine Gewohnheit, die du leicht wiederholen kannst. So wird aus Neugier etwas, das sich ganz natürlich in deinen Alltag einfügt.</p>
        <p class="oils-routine__detail">Ein Moment · eine Anwendung · ein kleiner Anfang</p>
      </div>
      <ResponsiveImage
        src="/assets/images/products/diffuser-lemon.jpg"
        alt="Diffuser und ätherisches Zitronenöl in einer hellen Umgebung"
        width={3600}
        height={2400}
        variant="portrait-wide"
        position="58% center"
        treatment="hero"
        sources={[
          { type: 'image/avif', srcset: '/assets/images/optimized/diffuser-lemon-640.avif 640w, /assets/images/optimized/diffuser-lemon-960.avif 960w, /assets/images/optimized/diffuser-lemon-1280.avif 1280w' },
          { type: 'image/webp', srcset: '/assets/images/optimized/diffuser-lemon-640.webp 640w, /assets/images/optimized/diffuser-lemon-960.webp 960w, /assets/images/optimized/diffuser-lemon-1280.webp 1280w' },
        ]}
      />
    </div>
  </section>

  <section class="section oils-learning" aria-labelledby="oils-learning-title">
    <div class="container oils-learning__inner" data-reveal>
      <div>
        <p class="eyebrow">IN DEINEM TEMPO WEITERLERNEN</p>
        <h2 id="oils-learning-title">Neugierig auf das Warum dahinter?</h2>
        <p>Im Knowledge Hub findest du verständliche Ölprofile, Hinweise zur sicheren Anwendung und einfache Routinen. Lies nach, vergleiche in Ruhe und entscheide erst dann, was du ausprobieren möchtest.</p>
        <p class="oils-learning__note">Wissen zuerst. Die Produkte folgen, wenn sie zu dir passen.</p>
      </div>
      <div class="oils-learning__actions">
        <a class="oils-learning__primary" href="/de/wissen/">Zum Knowledge Hub</a>
        <a class="oils-learning__secondary" href="/de/wissen/sicher-anwenden/">Sichere Anwendung <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <CTASection
    title="Fragen zu deinem Einstieg?"
    primaryHref="/de/kontakt/"
    primaryLabel="Beratung anfragen"
    secondaryHref="/de/wissen/"
    secondaryLabel="Wissen entdecken"
  >
    <p>Du musst noch kein Öl oder Set ausgewählt haben. Erzähl mir einfach, was dich interessiert – wir finden gemeinsam einen passenden nächsten Schritt.</p>
  </CTASection>

  <section class="compliance-section oils-compliance">
    <div class="container">
      <ComplianceNote label="Hinweis">
        <p class="oils-compliance__label">Hinweis</p>
        <p>Meine Beratung ersetzt keine medizinische Diagnose oder Behandlung. Ätherische Öle und Wellness-Produkte können Teil bewusster Routinen sein, ersetzen aber keine medizinische Betreuung.</p>
      </ComplianceNote>
    </div>
  </section>
  <script is:inline src="/scripts/consultation-motion.js" defer></script>
</PageLayout>
