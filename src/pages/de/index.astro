---
import CTASection from '../../components/cta/CTASection.astro';
import Button from '../../components/global/Button.astro';
import HeroSplit from '../../components/sections/HeroSplit.astro';
import ResponsiveImage from '../../components/global/ResponsiveImage.astro';
import SectionIntro from '../../components/sections/SectionIntro.astro';
import PageLayout from '../../layouts/PageLayout.astro';

const intentPaths = [
  { title: 'Ruhe & Abend', copy: 'Für eine angenehme Abendumgebung und persönliche Duftmomente.', href: '/de/wissen/routinen/einfache-abendroutine-mit-aetherischen-oelen/' },
  { title: 'Bewegung & Körperpflege', copy: 'Für Massage, Pflege und Routinen nach aktiven Tagen.', href: '/de/wissen/produkte-systeme/deep-blue-bewegung-massage-koerperkomfort/' },
  { title: 'Familie & sichere Anwendung', copy: 'Für Haushalte, in denen Menge, Raumgröße und Rücksicht wichtig sind.', href: '/de/wissen/sicher-anwenden/' },
  { title: 'Zuhause & Routinen', copy: 'Für Raumduft, Pflegegefühl und bewusste Gewohnheiten zuhause.', href: '/de/wissen/alltag/' },
];

const nextPaths = [
  { title: 'doTERRA verstehen', copy: 'Produktwelt, Qualität und Kundenkonto im Zusammenhang kennenlernen.', href: '/de/doterra-verstehen/' },
  { title: 'Workshops', copy: 'Ätherische Öle gemeinsam verstehen und Fragen in der Gruppe klären.', href: '/de/workshops/' },
  { title: 'Über Kyle', copy: 'Mehr über Kyles Weg, Fachwissen und Arbeitsweise erfahren.', href: '/de/ueber-kyle/' },
];

---

<PageLayout
  title="doTERRA Beratung & ätherische Öle im Alltag | Kyle Oils"
  description="Persönliche doTERRA Beratung, ätherische Öle und alltagstaugliche Routinen: Wissen, Produkte und sichere nächste Schritte mit Kyle einordnen."
>
  <HeroSplit
    title="Natürliche Routinen für mehr Balance im Alltag"
    primaryHref="/de/kontakt/"
    primaryLabel="Beratung anfragen"
    secondaryHref="/de/wissen/"
    secondaryLabel="Wissen entdecken"
    imageSrc="/assets/images/kyle/hero-kyle.png"
    imageAlt="Kyle Daniel Mikolajczak in ruhiger, heller Umgebung"
    imageWidth={1537}
    imageHeight={1023}
    imagePosition="75% center"
    imageSizes="(min-width: 1024px) 80vw, calc(100vw - 40px)"
    imageSources={[
      { type: 'image/avif', srcset: '/assets/images/optimized/hero-kyle-640.avif 640w, /assets/images/optimized/hero-kyle-960.avif 960w, /assets/images/optimized/hero-kyle-1280.avif 1280w, /assets/images/optimized/hero-kyle-1536.avif 1536w' },
      { type: 'image/webp', srcset: '/assets/images/optimized/hero-kyle-640.webp 640w, /assets/images/optimized/hero-kyle-960.webp 960w, /assets/images/optimized/hero-kyle-1280.webp 1280w, /assets/images/optimized/hero-kyle-1536.webp 1536w' },
    ]}
  >
    <p>Verstehe doTERRA, ätherische Öle und passende Routinen, bevor du entscheidest.</p>
    <p>Ich höre zu, ordne ein und begleite dich bei den nächsten Schritten.</p>
  </HeroSplit>

  <section class="trust-strip" aria-label="Qualifikation und Begleitung">
    <div class="container trust-strip__inner">
      <span>doTERRA Europe Essential Oils Specialist</span>
      <span>Unabhängiger Wellness Advocate</span>
      <span>Persönliche Begleitung auf Deutsch & Englisch</span>
    </div>
  </section>

  <section class="section section--nature">
    <div class="container narrow-layout" data-reveal>
      <SectionIntro title="Erst verstehen. Dann das Richtige wählen.">
        <p>Kyle Oils ist ein klarer Einstieg in ätherische Öle, doTERRA Produkte und Wellness-Routinen, die zu deinem Leben passen.</p>
        <p>Entdecke deine Möglichkeiten, stelle Fragen und wähle dann, was du wirklich nutzen wirst.</p>
      </SectionIntro>
    </div>
  </section>

  <section class="section section--cream intent-section">
    <div class="container" data-reveal>
      <p class="eyebrow">DEIN EINSTIEG</p>
      <SectionIntro title="Womit möchtest du anfangen?">
        <p>Wähle die Alltagssituation, die gerade am besten zu dir passt.</p>
      </SectionIntro>
      <div class="intent-grid">
        {intentPaths.map((path) => (
          <a class="intent-card" href={path.href}>
            <h2>{path.title}</h2>
            <p>{path.copy}</p>
            <span aria-hidden="true">Entdecken →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--sage knowledge-section">
    <div class="container knowledge-section__inner" data-reveal>
      <p class="eyebrow">WISSEN</p>
      <SectionIntro title="Wissen, das dich weiterbringt.">
        <p>Klare Grundlagen, sichere Anwendung, Routinen, Ölprofile und Produktwissen. So findest du einen fundierten Einstieg, der zu deinen Fragen passt.</p>
      </SectionIntro>
      <Button href="/de/wissen/">Wissen entdecken</Button>
      <p class="knowledge-links"><a href="/de/wissen/oel-lexikon/">Öl-Lexikon</a><a href="/de/starter-sets/">Starter-Sets</a><a href="/de/wissen/sicher-anwenden/">Sicher anwenden</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container split-layout" data-reveal>
      <div>
        <p class="eyebrow">MIT KYLE STARTEN</p>
        <SectionIntro title="Beratung, die bei dir beginnt.">
          <p>Meine Beratung startet nicht mit einer Produktliste. Ich höre erst zu, damit Auswahl und Routinen wirklich zu dir passen.</p>
          <p>Du bekommst klare Einordnung, einen sicherheitsbewussten Einstieg und jemanden, der auch nach dem Start ansprechbar bleibt.</p>
        </SectionIntro>
        <ul class="trust-points"><li>Klare Produkt- und Routinen-Einordnung</li><li>Sicherheitsbewusste Anwendung</li><li>Persönliche Begleitung, wenn Fragen entstehen</li></ul>
        <div class="credential-row"><img src="/assets/images/certificates/eos-specialist-badge-cropped.png" alt="doTERRA Europe Essential Oils Specialist Zertifikat" width="108" height="108" loading="lazy" decoding="async" /><p><strong>Qualifiziert und persönlich.</strong><br />doTERRA Europe Essential Oils Specialist</p></div>
        <Button href="/de/kontakt/">Mit Kyle sprechen</Button>
      </div>
      <ResponsiveImage
        src="/assets/images/workshops/consultation-01.png"
        alt="Persönliche Beratung zu ätherischen Ölen in ruhiger Atmosphäre"
        width={1672}
        height={941}
        variant="portrait"
        position="50% center"
        sources={[
          { type: 'image/avif', srcset: '/assets/images/optimized/consultation-01-640.avif 640w, /assets/images/optimized/consultation-01-960.avif 960w, /assets/images/optimized/consultation-01-1280.avif 1280w' },
          { type: 'image/webp', srcset: '/assets/images/optimized/consultation-01-640.webp 640w, /assets/images/optimized/consultation-01-960.webp 960w, /assets/images/optimized/consultation-01-1280.webp 1280w' },
        ]}
      />
    </div>
  </section>

  <section class="section section--cream next-paths-section">
    <div class="container" data-reveal>
      <p class="eyebrow">WEITERENTDECKEN</p>
      <SectionIntro title="Wo möchtest du weitermachen?" />
      <div class="next-paths-grid">
        {nextPaths.map((path) => <a class="next-path-card" href={path.href}><h2>{path.title}</h2><p>{path.copy}</p><span aria-hidden="true">Weiter →</span></a>)}
      </div>
    </div>
  </section>

  <CTASection
    title="Möchtest du persönlich starten?"
    primaryHref="/de/kontakt/"
    primaryLabel="Beratung anfragen"
  >
    <p>Erzähl mir, was dich interessiert. Gemeinsam finden wir einen klaren nächsten Schritt.</p>
  </CTASection>

  <section class="homepage-note" aria-label="Hinweis">
    <div class="container homepage-note__inner">
      <p><strong>Hinweis:</strong> Meine Beratung ersetzt keine medizinische Diagnose oder Behandlung. Mein Fokus liegt auf verständlicher Orientierung, sicheren Alltagsroutinen und persönlicher Begleitung.</p>
    </div>
  </section>
</PageLayout>

<style>
  .section { padding: var(--space-64) 0; }
  .section--cream { background: var(--color-soft-cream); }
  .section--nature { position: relative; isolation: isolate; background: var(--color-soft-cream); }
  .section--nature::before { content: ''; position: absolute; inset: 0; z-index: -2; background-color: var(--color-soft-cream); background-image: image-set(url('/assets/images/optimized/nature-heath-hero-01-640.avif') type('image/avif') 1x, url('/assets/images/optimized/nature-heath-hero-01-960.avif') type('image/avif') 2x, url('/assets/images/optimized/nature-heath-hero-01-640.webp') type('image/webp') 1x, url('/assets/images/optimized/nature-heath-hero-01-960.webp') type('image/webp') 2x); background-position: center 54%; background-size: cover; background-repeat: no-repeat; }
  .section--nature::after { content: ''; position: absolute; inset: 0; z-index: -1; background: rgb(250 247 241 / 74%); }
  .section--sage { background: rgb(168 184 160 / 20%); }
  .trust-strip { padding: var(--space-20) 0; border-bottom: 1px solid rgb(216 199 173 / 55%); background: var(--color-warm-white); }
  .trust-strip__inner { display: grid; gap: var(--space-12); color: var(--color-text-secondary); font-size: var(--font-size-small); font-weight: var(--font-weight-medium); text-align: center; }
  .eyebrow { margin: 0 0 var(--space-12); color: var(--color-olive-grey); font-size: var(--font-size-small); font-weight: var(--font-weight-semibold); letter-spacing: .12em; }
  .knowledge-section__inner, .narrow-layout { max-width: var(--container-text); }
  .knowledge-links { display: flex; flex-wrap: wrap; gap: var(--space-16) var(--space-24); margin: var(--space-24) 0 0; }
  .knowledge-links a { display: inline-flex; align-items: center; gap: var(--space-8); padding-bottom: 2px; border-bottom: 1px solid rgb(46 70 56 / 35%); color: var(--color-deep-forest); font-size: var(--font-size-small); font-weight: var(--font-weight-semibold); text-decoration: none; }
  .knowledge-links a::after { content: '→'; transition: transform 160ms ease; }
  .knowledge-links a:hover::after, .knowledge-links a:focus-visible::after { transform: translateX(3px); }
  .intent-grid { display: grid; gap: var(--space-16); margin-top: var(--space-32); }
  .intent-card { display: grid; gap: var(--space-12); padding: var(--space-24); border: 1px solid rgb(216 199 173 / 70%); border-radius: var(--radius-card); background: var(--color-warm-white); box-shadow: var(--shadow-card); color: var(--color-text-primary); text-decoration: none; transition: transform 160ms ease, box-shadow 160ms ease; }
  .intent-card:hover, .intent-card:focus-visible { box-shadow: var(--shadow-hover); transform: translateY(-2px); }
  .intent-card h2 { margin: 0; font-size: var(--font-size-h3-mobile); line-height: 1.2; }
  .intent-card p { margin: 0; color: var(--color-text-secondary); }
  .intent-card > span { color: var(--color-deep-forest); font-size: var(--font-size-small); font-weight: var(--font-weight-semibold); }
  .split-layout { display: grid; gap: var(--space-40); align-items: center; }
  .trust-points { display: grid; gap: var(--space-8); margin: 0 0 var(--space-24); padding: 0; list-style: none; color: var(--color-text-secondary); }
  .trust-points li { position: relative; padding-left: var(--space-20); }
  .trust-points li::before { content: ''; position: absolute; top: .68em; left: 0; width: 8px; height: 8px; border-radius: 50%; background: var(--color-sage-green); }
  .credential-row { display: flex; align-items: center; gap: var(--space-16); margin: 0 0 var(--space-24); padding-top: var(--space-20); border-top: 1px solid rgb(216 199 173 / 70%); }
  .credential-row img { width: 88px; height: 88px; object-fit: contain; }
  .credential-row p { margin: 0; color: var(--color-text-secondary); font-size: var(--font-size-small); }
  .next-paths-grid { display: grid; gap: var(--space-16); margin-top: var(--space-32); }
  .next-path-card { display: grid; gap: var(--space-12); padding: var(--space-24); border: 1px solid rgb(216 199 173 / 70%); border-radius: var(--radius-card); background: var(--color-warm-white); box-shadow: var(--shadow-card); color: var(--color-text-primary); text-decoration: none; }
  .next-path-card h2, .next-path-card p { margin: 0; }
  .next-path-card p { color: var(--color-text-secondary); }
  .next-path-card span { color: var(--color-deep-forest); font-size: var(--font-size-small); font-weight: var(--font-weight-semibold); }
  .homepage-note { padding: 0 0 var(--space-48); background: var(--color-warm-white); }
  .homepage-note__inner { max-width: var(--container-text); padding-top: var(--space-24); border-top: 1px solid rgb(216 199 173 / 65%); color: var(--color-text-secondary); font-size: var(--font-size-small); line-height: var(--line-height-small); }
  .homepage-note p { margin: 0; }
  @media (min-width: 768px) {
    .section--nature::before { background-image: image-set(url('/assets/images/optimized/nature-heath-hero-01-960.avif') type('image/avif') 1x, url('/assets/images/optimized/nature-heath-hero-01-1280.avif') type('image/avif') 2x, url('/assets/images/optimized/nature-heath-hero-01-960.webp') type('image/webp') 1x, url('/assets/images/optimized/nature-heath-hero-01-1280.webp') type('image/webp') 2x); }
    .section { padding-block: var(--space-96); }
    .trust-strip__inner { grid-template-columns: repeat(3, 1fr); gap: 0; }
    .trust-strip__inner span + span { border-left: 1px solid rgb(216 199 173 / 70%); }
    .intent-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-24); }
    .next-paths-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-24); }
    .credential-row img { width: 108px; height: 108px; }
  }
  @media (min-width: 1024px) {
    .section--nature::before { background-image: image-set(url('/assets/images/optimized/nature-heath-hero-01-1280.avif') type('image/avif') 1x, url('/assets/images/optimized/nature-heath-hero-01-1672.avif') type('image/avif') 2x, url('/assets/images/optimized/nature-heath-hero-01-1280.webp') type('image/webp') 1x, url('/assets/images/optimized/nature-heath-hero-01-1672.webp') type('image/webp') 2x); }
    .section { padding-block: var(--space-120); }
    .split-layout { grid-template-columns: minmax(0, 1fr) minmax(360px, .8fr); gap: var(--space-80); }
    .intent-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .intent-card h2 { font-size: var(--font-size-h3-desktop); }
  }
</style>
