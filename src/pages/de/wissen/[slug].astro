---
import KnowledgeWorldTemplate from '../../../components/knowledge/KnowledgeWorldTemplate.astro';
import { getKnowledgeBreadcrumbs, getKnowledgeWorldBySlug, knowledgeWorlds } from '../../../data/knowledge';
import { getKnowledgeArticlesForWorld } from '../../../data/knowledgeArticles';
import PageLayout from '../../../layouts/PageLayout.astro';

export function getStaticPaths() {
  return knowledgeWorlds.map((world) => ({
    params: { slug: world.href.de.split('/').filter(Boolean).at(-1) },
  }));
}

const world = getKnowledgeWorldBySlug('de', Astro.params.slug ?? '');
if (!world) return Astro.redirect('/de/wissen/');
const relatedWorlds = knowledgeWorlds.filter((item) => item.id !== world.id).slice(0, 3);
const articles = getKnowledgeArticlesForWorld(world.id);
---

<PageLayout title={`${world.label.de} | Wissen | Kyle Daniel Mikolajczak`} description={world.description.de}>
  <KnowledgeWorldTemplate locale="de" {world} breadcrumbs={getKnowledgeBreadcrumbs('de', world.id)} {relatedWorlds} {articles} />
</PageLayout>
