---
import ComplianceNote from '../../../components/compliance/ComplianceNote.astro';
import CTASection from '../../../components/cta/CTASection.astro';
import HeroSplit from '../../../components/sections/HeroSplit.astro';
import PageLayout from '../../../layouts/PageLayout.astro';

const qualityPrinciples = [
  'Sorgfältige Auswahl der Pflanzen',
  'Weltweites Netzwerk',
  'Hohe Qualitätsstandards',
  'Umfangreiche Qualitätskontrollen',
  'Fokus auf Reinheit',
  'Transparenz',
];

const sourcingPrinciples = [
  'Zusammenarbeit mit Bauern weltweit',
  'Langfristige Partnerschaften',
  'Faire Bezahlung',
  'Nachhaltiger Anbau',
  'Unterstützung lokaler Gemeinschaften',
];

const productAreas = [
  'Ätherische Einzelöle',
  'Synergy-Mischungen',
  'Nahrungsergänzung',
  'Körperpflege',
  'Spa & Hautpflege',
  'Haushalt',
  'Wellness-Systeme',
];

const accountDetails = [
  'Offizielles Kundenkonto direkt bei doTERRA',
  'Persönlicher Ansprechpartner',
  'Produkte zum Einkaufspreis mit 25 % Preisvorteil gegenüber dem regulären Verkaufspreis',
  'Kein Kaufzwang',
  'Kein Abo notwendig',
  'Jeder entscheidet selbst',
];
import '../../../styles/doterra-understanding-refined.css';
---


<PageLayout
  title="doTERRA verstehen | Produkte, Kundenkonto & Einstieg | Kyle Oils"
  description="Verstehe, was doTERRA ist, welche Produktbereiche es gibt, wie das Kundenkonto funktioniert und wie du mit persönlicher Orientierung starten kannst."
>
  <HeroSplit
    title="doTERRA verstehen"
    primaryHref="/de/starter-sets/"
    primaryLabel="Starter-Sets vergleichen"
    secondaryHref="/de/wissen/produkte-systeme/doterra-kundenkonto-und-einkaufsvorteil-verstehen/"
    secondaryLabel="Kundenkonto verstehen"
    imageSrc="/assets/images/nature/nature-heath-hero-01.png"
    imageAlt="Lüneburger Heide im warmen Licht"
    imageWidth={1672}
    imageHeight={941}
    imagePosition="56% center"
    imageSources={[
      { type: 'image/avif', srcset: '/assets/images/optimized/nature-heath-hero-01-640.avif 640w, /assets/images/optimized/nature-heath-hero-01-960.avif 960w, /assets/images/optimized/nature-heath-hero-01-1280.avif 1280w, /assets/images/optimized/nature-heath-hero-01-1672.avif 1672w' },
      { type: 'image/webp', srcset: '/assets/images/optimized/nature-heath-hero-01-640.webp 640w, /assets/images/optimized/nature-heath-hero-01-960.webp 960w, /assets/images/optimized/nature-heath-hero-01-1280.webp 1280w, /assets/images/optimized/nature-heath-hero-01-1672.webp 1672w' },
    ]}
  >
    <p>Vielleicht hast du schon von doTERRA gehört und möchtest besser verstehen, wofür das Unternehmen steht.</p>
    <p>Auf dieser Seite findest du einen einfachen Überblick, ohne Verkaufsdruck und ohne komplizierte Fachbegriffe.</p>
  </HeroSplit>

  <section class="section dt-overview" aria-labelledby="dt-overview-title">
    <div class="container dt-wrap dt-overview__layout" data-reveal>
      <div class="dt-overview__heading">
        <p class="eyebrow">DIE MARKE KENNENLERNEN</p>
        <h2 id="dt-overview-title">Die Idee hinter doTERRA.</h2>
        <p>Bevor du dich für ein Öl oder ein Set entscheidest, lohnt sich ein Blick darauf, wer hinter den Produkten steht.</p>
      </div>
      <div class="dt-overview__panel">
        <p>doTERRA ist ein international tätiges Wellness-Unternehmen mit Schwerpunkt ätherische Öle. Der Name bedeutet „Geschenk der Erde“.</p>
        <ul><li>2008 gegründet</li><li>Internationales Unternehmen</li><li>Ätherische Öle & Wellness</li></ul>
      </div>
    </div>
  </section>

  <section class="section dt-quality" aria-labelledby="dt-quality-title">
    <div class="container dt-wrap">
      <header class="dt-heading" data-reveal>
        <p class="eyebrow">QUALITÄT & KONTROLLE</p>
        <h2 id="dt-quality-title">Warum die Qualität im Mittelpunkt steht.</h2>
        <p>doTERRA beschreibt umfassende Schritte von der Pflanzenauswahl bis zur Prüfung der fertigen Öle. Diese Prinzipien zeigen, worauf das Unternehmen Wert legt.</p>
      </header>
      <ol class="dt-quality__grid" data-consultation-cards>
        {qualityPrinciples.map((principle,index)=><li class="dt-quality__card" data-consultation-card>
          <span class="dt-number" aria-hidden="true">{String(index+1).padStart(2,"0")}</span>
          <h3>{principle}</h3>
        </li>)}
      </ol>
    </div>
  </section>

  <section class="section dt-sourcing" aria-labelledby="dt-sourcing-title">
    <div class="container dt-wrap">
      <div class="dt-sourcing__panel" data-reveal>
        <div class="dt-sourcing__copy">
          <p class="eyebrow">VERANTWORTUNG & HERKUNFT</p>
          <h2 id="dt-sourcing-title">Woher die Pflanzen kommen.</h2>
          <p>Co-Impact Sourcing® beschreibt das Beschaffungsmodell von doTERRA mit langfristigen Beziehungen zu landwirtschaftlichen Erzeugern und Gemeinschaften. Nachhaltigkeit ist ein wichtiges Ziel des Modells.</p>
          <span class="dt-sourcing__tag">Co-Impact Sourcing®</span>
          <p class="dt-sourcing__note">Wie Anbau und Projekte konkret aussehen, hängt von Region, Pflanzenart und lokaler Partnerschaft ab.</p>
        </div>
        <ol class="dt-sourcing__list">
          {sourcingPrinciples.map((principle,index)=><li>
            <span class="dt-number" aria-hidden="true">{String(index+1).padStart(2,"0")}</span>
            <span>{principle}</span>
          </li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="section dt-products" aria-labelledby="dt-products-title">
    <div class="container dt-wrap">
      <header class="dt-heading" data-reveal>
        <p class="eyebrow">PRODUKTVIELFALT</p>
        <h2 id="dt-products-title">Mehr als einzelne ätherische Öle.</h2>
        <p>Vom einzelnen Öl bis zur durchdachten Alltagsroutine: Entdecke, welche Produktbereiche es gibt, und informiere dich vor der Anwendung.</p>
      </header>
      <div class="dt-products__grid" data-consultation-cards>
        {productAreas.map((area,index)=><article class="dt-products__card" data-consultation-card>
          <span class="dt-number" aria-hidden="true">{String(index+1).padStart(2,"0")}</span>
          <h3>{area}</h3>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section dt-account" aria-labelledby="dt-account-title">
    <div class="container dt-wrap dt-account__layout" data-reveal>
      <div class="dt-account__copy">
        <p class="eyebrow">DEIN KUNDENKONTO</p>
        <h2 id="dt-account-title">Selbst entscheiden, wie du startest.</h2>
        <p>Ein offizielles Kundenkonto wird direkt bei doTERRA geführt. Du entscheidest selbst, ob, wann und welche Produkte du bestellst.</p>
        <p class="dt-account__note">Der 25-%-Preisvorteil bezieht sich auf den regulären Verkaufspreis bei entsprechender Kundenberechtigung. Bereits ausgewiesene Mitglieds- oder Setpreise werden dadurch nicht noch einmal reduziert. Bedingungen können je nach Markt variieren.</p>
      </div>
      <ol class="dt-account__list">
        {accountDetails.map((detail,index)=><li>
          <span class="dt-number" aria-hidden="true">{String(index+1).padStart(2,"0")}</span>
          <span>{detail}</span>
        </li>)}
      </ol>
    </div>
  </section>

  <section class="section dt-support" aria-labelledby="dt-support-title">
    <div class="container dt-wrap">
      <div class="dt-support__panel" data-reveal>
        <div>
          <p class="eyebrow">DEINE PERSÖNLICHE BEGLEITUNG</p>
          <h2 id="dt-support-title">Eine Ansprechperson. Auch nach der Bestellung.</h2>
        </div>
        <div class="dt-support__text"><p>Ich bin nicht der Hersteller und möchte dir nichts aufdrängen. Ich höre zu, beantworte Fragen und helfe dir dabei, Produkte und einfache, sichere Routinen kennenzulernen.</p><p>Du brauchst dich nicht allein durch alle Möglichkeiten zu arbeiten. Wir finden gemeinsam heraus, womit du sinnvoll beginnst.</p></div>
      </div>
    </div>
  </section>

  <CTASection
    title="Dein nächster Schritt: entdecken oder fragen."
    primaryHref="/de/wissen/"
    primaryLabel="Wissen entdecken"
    secondaryHref="/de/kontakt/"
    secondaryLabel="Mit Kyle sprechen"
  >
    <p>Lies in Ruhe weiter oder schreib mir persönlich. Wir finden gemeinsam heraus, welche Informationen oder Produkte für dich wirklich relevant sind.</p>
  </CTASection>

  <section class="compliance-section dt-compliance">
    <div class="container">
      <ComplianceNote label="Hinweis">
        <p class="dt-compliance__label">Hinweis</p>
        <p>Meine Begleitung ersetzt keine medizinische Diagnose oder Behandlung. Ich gebe keine Heilversprechen und mache keine medizinischen Behandlungsaussagen.</p>
      </ComplianceNote>
    </div>
  </section>
  <script is:inline src="/scripts/consultation-motion.js" defer></script>
</PageLayout>
